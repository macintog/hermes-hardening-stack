+class TestSlackSafeDownloads:
+    @pytest.mark.asyncio
+    async def test_send_image_uses_safe_download_bytes(self, adapter, monkeypatch):
+        calls = []
+
+        class Result:
+            content = b"\x89PNG\r\n\x1a\nimage"
+            content_type = "image/png"
+
+        async def fake_safe_download(url, **kwargs):
+            calls.append((url, kwargs))
+            return Result()
+
+        monkeypatch.setattr("plugins.platforms.slack.adapter.safe_download_bytes", fake_safe_download)
+        monkeypatch.setattr("tools.url_safety.is_safe_url", lambda _url: True)
+        adapter._app.client.files_upload_v2 = AsyncMock(return_value={"ok": True, "file": {"id": "F1"}})
+
+        result = await adapter.send_image("C123", "https://cdn.example/image.png", caption="hi")
+
+        assert result.success is True
+        assert calls[0][0] == "https://cdn.example/image.png"
+        kwargs = calls[0][1]
+        assert kwargs["max_bytes"] > 0
+        assert kwargs["source_type"] == "gateway:slack-outbound-image"
+        assert kwargs["policy"]["redirect_credentials"] == "no-credentials"
+        adapter._app.client.files_upload_v2.assert_awaited_once()
+        assert adapter._app.client.files_upload_v2.await_args.kwargs["content"] == Result.content
+
+    @pytest.mark.asyncio
+    async def test_private_file_download_keeps_bearer_on_slack_origin_only(self, adapter, monkeypatch):
+        calls = []
+
+        class Result:
+            content = b"%PDF-1.4\n%%EOF"
+            content_type = "application/pdf"
+
+        async def fake_safe_download(url, **kwargs):
+            calls.append((url, kwargs))
+            return Result()
+
+        monkeypatch.setattr("plugins.platforms.slack.adapter.safe_download_bytes", fake_safe_download)
+
+        content = await adapter._download_slack_file_bytes("https://files.slack.com/report.pdf")
+
+        assert content == Result.content
+        kwargs = calls[0][1]
+        assert kwargs["headers"]["Authorization"] == "Bearer xoxb-fake-token"
+        assert kwargs["policy"]["redirect_credentials"] == "same-origin-only"
+
+    @pytest.mark.asyncio
+    async def test_private_file_download_does_not_send_bearer_to_non_slack_origin(self, adapter, monkeypatch):
+        calls = []
+
+        class Result:
+            content = b"%PDF-1.4\n%%EOF"
+            content_type = "application/pdf"
+
+        async def fake_safe_download(url, **kwargs):
+            calls.append((url, kwargs))
+            return Result()
+
+        monkeypatch.setattr("plugins.platforms.slack.adapter.safe_download_bytes", fake_safe_download)
+
+        await adapter._download_slack_file_bytes("https://cdn.example/report.pdf")
+
+        kwargs = calls[0][1]
+        assert kwargs["headers"] == {}
+        assert kwargs["policy"]["redirect_credentials"] == "no-credentials"
+
+    @pytest.mark.asyncio
+    async def test_send_multiple_images_uses_safe_download_bytes(self, adapter, monkeypatch):
+        calls = []
+
+        class Result:
+            content = b"\x89PNG\r\n\x1a\nimage"
+            content_type = "image/png"
+
+        async def fake_safe_download(url, **kwargs):
+            calls.append((url, kwargs))
+            return Result()
+
+        monkeypatch.setattr("plugins.platforms.slack.adapter.safe_download_bytes", fake_safe_download)
+        adapter._app.client.files_upload_v2 = AsyncMock(return_value={"ok": True})
+
+        await adapter.send_multiple_images(
+            "C123",
+            [("https://cdn.example/image.png", "alt text")],
+        )
+
+        assert calls[0][0] == "https://cdn.example/image.png"
+        kwargs = calls[0][1]
+        assert kwargs["source_type"] == "gateway:slack-outbound-image"
+        assert kwargs["policy"]["redirect_credentials"] == "no-credentials"
+        adapter._app.client.files_upload_v2.assert_awaited_once()
+        upload = adapter._app.client.files_upload_v2.await_args.kwargs["file_uploads"][0]
+        assert upload["content"] == Result.content
+
+    @pytest.mark.asyncio
+    async def test_send_multiple_images_blocks_safe_http_redirect_without_upload(self, adapter, monkeypatch):
+        from tools.safe_http import SafeHTTPError
+
+        mock_download = AsyncMock(
+            side_effect=SafeHTTPError(
+                "Blocked unsafe URL target: http://169.254.169.254/latest/meta-data"
+            )
+        )
+        monkeypatch.setattr("plugins.platforms.slack.adapter.safe_download_bytes", mock_download)
+        adapter._app.client.files_upload_v2 = AsyncMock(return_value={"ok": True})
+
+        await adapter.send_multiple_images(
+            "C123",
+            [("https://public.example/redirect.png", "alt text")],
+        )
+
+        mock_download.assert_awaited_once()
+        adapter._app.client.files_upload_v2.assert_not_awaited()
+
+
