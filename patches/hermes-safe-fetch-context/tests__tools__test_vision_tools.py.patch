+def test_download_image_uses_safe_download_to_file(tmp_path, monkeypatch):
+    source = tmp_path / "downloaded-safe-http.png"
+    source.write_bytes(b"\x89PNG\r\n\x1a\n" + b"\x00" * 16)
+    destination = tmp_path / "image.png"
+    calls = []
+
+    class Result:
+        final_url = "https://example.com/image.png"
+
+    async def fake_safe_download_to_file(url, **kwargs):
+        calls.append((url, kwargs))
+        return str(source), Result()
+
+    monkeypatch.setattr("tools.vision_tools.safe_download_to_file", fake_safe_download_to_file)
+    monkeypatch.setattr("tools.vision_tools.check_website_access", lambda _url: None)
+
+    result = asyncio.run(_download_image("https://example.com/image.png", destination, max_retries=1))
+
+    assert result == destination
+    assert destination.read_bytes().startswith(b"\x89PNG")
+    assert calls[0][1]["max_bytes"] == 50 * 1024 * 1024
+    assert calls[0][1]["source_type"] == "vision_image"
+    assert "image/png" in calls[0][1]["allowed_content_types"]
+    assert "image/svg+xml" not in calls[0][1]["allowed_content_types"]
+
+
+def test_vision_analyze_result_includes_native_evidence_ledger(tmp_path, monkeypatch):
+    img = tmp_path / "fixture.png"
+    img.write_bytes(b"\x89PNG\r\n\x1a\n" + b"\x00" * 16)
+
+    class _Response:
+        choices = [MagicMock(message=MagicMock(content="A harmless image."))]
+
+    async def _fake_call_llm(**kwargs):
+        return _Response()
+
+    monkeypatch.setattr("tools.vision_tools.async_call_llm", _fake_call_llm)
+    monkeypatch.setattr("tools.interrupt.is_interrupted", lambda: False)
+
+    result = json.loads(asyncio.run(vision_analyze_tool(str(img), "What is this?")))
+
+    assert result["success"] is True
+    assert result["analysis"] == "A harmless image."
+    ledger = result["evidence_ledger"]
+    assert ledger["schema"] == "hermes.tool_result_ledger.v1"
+    assert ledger["ledger_origin"] == "native_tool"
+    assert ledger["tool_name"] == "vision_analyze"
+    assert ledger["read_only"] is True
+    item = ledger["evidence_items"][0]
+    assert item["kind"] == "vision_observation"
+    assert item["text_ref"] == "analysis"
+    assert item["text"] is None
+    assert item["evidence_only"] is True
+    assert item["verbatim"] is False
+    assert item["source_type"] == "local_image"
+    assert item["content_type"] == "image/png"
+    assert item["byte_count"] == img.stat().st_size
+    assert ledger["side_effects"] == []
+    assert ledger["action_decisions"] == []
+    assert ledger["metadata"]["ledgers_exposed"] is True
+
+
