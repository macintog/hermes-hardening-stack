+
+EXPLICIT_TOOL_EXEMPTIONS: dict[str, str] = {
+    "todo": "agent-loop planning state only; mediated by the agent loop",
+    "clarify": "agent-loop user confirmation prompt; cannot perform external side effects by itself",
+    "delegate_task": "agent-loop orchestration primitive; subagent tool calls remain subject to their own authority gates",
+}
+
+
+def action_class_for_tool(tool_name: str) -> ActionClass:
+    """Return the stable catalog class for a tool name."""
+    return TOOL_ACTION_CLASSES.get((tool_name or "").lower(), ActionClass.UNKNOWN_SIDE_EFFECT)
+
+
+def classified_tool_names() -> set[str]:
+    return set(TOOL_ACTION_CLASSES)
+
+
+def action_authority_coverage_gaps(
+    tool_names: set[str],
+    *,
+    classifier: Callable[[str, Mapping[str, object] | None], ActionClass] | None = None,
+) -> dict[str, list[str]]:
+    classified = classified_tool_names() | set(EXPLICIT_TOOL_EXEMPTIONS)
+    missing = sorted(set(tool_names) - classified)
+    classify = classifier or (lambda name, _args=None: action_class_for_tool(name))
+    unknown = sorted(
+        name
+        for name in set(tool_names)
+        if name in classified
+        and name not in EXPLICIT_TOOL_EXEMPTIONS
+        and classify(name, {}) == ActionClass.UNKNOWN_SIDE_EFFECT
+    )
+    return {"missing": missing, "unknown": unknown}
