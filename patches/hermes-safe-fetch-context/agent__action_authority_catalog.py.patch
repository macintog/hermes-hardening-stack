+    READ_ONLY_NETWORK_FETCH = "read_only_network_fetch"
+    CREDENTIALED_NETWORK_CALL = "credentialed_network_call"
+    FILE_WRITE = "file_write"
+    FILE_DELETE = "file_delete"
+    TERMINAL_EXECUTION = "terminal_execution"
+    SECRET_READ = "secret_read"
+    SECRET_TRANSMISSION = "secret_transmission"
+    OUTBOUND_MESSAGE = "outbound_message"
+    MEMORY_WRITE = "memory_write"
+    CRON_CREATE_UPDATE_DELETE = "cron_create_update_delete"
+    SKILL_PLUGIN_INSTALL_UPDATE = "skill_plugin_install_update"
+    SKILL_PLUGIN_EXECUTE = "skill_plugin_execute"
+    CODE_EXECUTION_FROM_DOWNLOAD = "code_execution_from_download"
+    CONFIGURATION_CHANGE = "configuration_change"
+    AGENT_LOOP_INTERNAL = "agent_loop_internal"
+    UNKNOWN_SIDE_EFFECT = "unknown_side_effect"
+
+
+READ_ONLY_CLASSES = {
+    ActionClass.READ_ONLY_LOCAL_INSPECTION,
+    ActionClass.READ_ONLY_NETWORK_FETCH,
+}
+
+HIGH_RISK_APPROVAL_CLASSES = {
+    ActionClass.OUTBOUND_MESSAGE,
+    ActionClass.FILE_WRITE,
+    ActionClass.FILE_DELETE,
+    ActionClass.MEMORY_WRITE,
+    ActionClass.CRON_CREATE_UPDATE_DELETE,
+    ActionClass.CONFIGURATION_CHANGE,
+    ActionClass.SKILL_PLUGIN_INSTALL_UPDATE,
+    ActionClass.SKILL_PLUGIN_EXECUTE,
+    ActionClass.CREDENTIALED_NETWORK_CALL,
+    ActionClass.TERMINAL_EXECUTION,
+    ActionClass.SECRET_READ,
+    ActionClass.SECRET_TRANSMISSION,
+    ActionClass.CODE_EXECUTION_FROM_DOWNLOAD,
+    ActionClass.UNKNOWN_SIDE_EFFECT,
+}
+
+AGENT_LOOP_INTERNAL_TOOLS = {"todo", "clarify", "delegate_task", "session_search"}
+
+# Complete explicit classification for built-in registered tools. New registered
+# tools must be added here, or the registry coverage test fails. Unknown dynamic
+# tools require confirmation by default.
