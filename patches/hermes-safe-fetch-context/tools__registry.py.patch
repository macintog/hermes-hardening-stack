+def _availability_env_value(name: str, value: str) -> str:
+    """Return a non-secret value suitable for an availability-cache key."""
+    if any(marker in name for marker in _SECRET_ENV_MARKERS):
+        return "<set>" if value else ""
+    return value
+
+
+def _check_fn_env_fingerprint() -> tuple[tuple[str, str], ...]:
+    """Fingerprint env inputs that affect tool availability probes.
+
+    Check functions decide whether tools like terminal/file/browser-backed
+    tools are available. Several tests intentionally flip these env vars in a
+    single process, so caching only by callable can reuse a stale negative
+    result after the env is restored.
+    """
+    return tuple(
+        sorted(
+            (name, _availability_env_value(name, value))
+            for name, value in os.environ.items()
+            if name in _CHECK_FN_ENV_NAMES
+            or any(name.startswith(prefix) for prefix in _CHECK_FN_ENV_PREFIXES)
+        )
+    )
+
 
