+    def test_hub_installed_skill_is_evidence_only_and_does_not_expand_shell(self, tmp_path):
+        _make_skill(
+            tmp_path,
+            "hub-skill",
+            body="Install note: !`printf SHOULD_NOT_RUN`",
+        )
+        _write_hub_lock(tmp_path, "hub-skill")
+
+        with (
+            patch("tools.skills_tool.SKILLS_DIR", tmp_path),
+            patch(
+                "agent.skill_preprocessing.load_skills_config",
+                return_value={"template_vars": True, "inline_shell": True},
+            ),
+            patch(
+                "agent.skill_preprocessing.expand_inline_shell",
+                side_effect=AssertionError("evidence-only skill expanded inline shell"),
+            ),
+        ):
+            raw = skill_view("hub-skill")
+
+        result = json.loads(raw)
+        assert result["success"] is True
+        assert result["authority"] == "evidence_only"
+        assert result["skill_provenance"]["provenance"] == "community-hub"
+        assert "Install note: !`printf SHOULD_NOT_RUN`" in result["content"]
+
