+def _write_hub_lock(
+    skills_dir: Path,
+    name: str,
+    *,
+    source: str = "github",
+    trust_level: str = "community",
+    install_path: str | None = None,
+) -> None:
+    hub_dir = skills_dir / ".hub"
+    hub_dir.mkdir(parents=True, exist_ok=True)
+    if install_path is None:
+        install_path = name
+    hub_dir.joinpath("lock.json").write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "installed": {
+                    name: {
+                        "source": source,
+                        "identifier": f"{source}:example/{name}",
+                        "trust_level": trust_level,
+                        "provenance": {
+                            "source_type": "bundled" if source == "official" else "community-hub",
+                            "authority": "trusted_by_local_policy" if source == "official" else "evidence_only",
+                            "promotion_required": source != "official",
+                        },
+                        "scan_verdict": "pass",
+                        "content_hash": "old-hash",
+                        "install_path": install_path,
+                        "files": ["SKILL.md"],
+                        "metadata": {},
+                        "installed_at": "2026-04-29T00:00:00+00:00",
+                        "updated_at": "2026-04-29T00:00:00+00:00",
+                    }
+                },
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+
+
+def _write_skill_provenance_sidecar(
+    skills_dir: Path,
+    name: str,
+    *,
+    source_type: str = "community-hub",
+    source: str = "github",
+    identifier: str = "owner/repo/skill",
+) -> None:
+    (skills_dir / name / ".hermes_skill_provenance.json").write_text(
+        json.dumps(
+            {
+                "version": 1,
+                "source": source,
+                "identifier": identifier,
+                "trust_level": "community",
+                "provenance": {
+                    "source_type": source_type,
+                    "authority": "evidence_only",
+                    "promotion_required": True,
+                },
+            }
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+
+
