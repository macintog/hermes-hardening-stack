 # re-resolve per call so the active profile override is honored.
 IMAGE_CACHE_DIR = get_hermes_dir("cache/images", "image_cache")
+MEDIA_CACHE_MAX_BYTES = 25 * 1024 * 1024
+TRUSTED_MEDIA_ARTIFACT_MARKER = "[[hermes_trusted_media_artifact_v1]]"
+
+def _media_cache_retry_count(retries: int) -> int:
+    try:
+        return max(0, int(retries))
+    except (TypeError, ValueError):
+        return 0
+
+
+def _is_transient_media_cache_error(exc: Exception) -> bool:
+    text = str(exc)
+    return (
+        "ReadTimeout" in text
+        or "ConnectTimeout" in text
+        or "PoolTimeout" in text
+        or "TimeoutException" in text
+        or re.search(r"HTTP status (429|5\d\d)\b", text) is not None
+    )
+
+
+async def _safe_download_media_with_retries(url: str, *, retries: int, cache_label: str, **kwargs):
+    from tools.safe_http import SafeHTTPError, safe_download_bytes
+
+    retry_count = _media_cache_retry_count(retries)
+    attempts = retry_count + 1
+    _log = logging.getLogger(__name__)
+    for attempt in range(attempts):
+        try:
+            return await safe_download_bytes(url, **kwargs)
+        except SafeHTTPError as exc:
+            if attempt >= retry_count or not _is_transient_media_cache_error(exc):
+                raise
+            wait = min(1.5 * (attempt + 1), 5.0)
+            _log.debug(
+                "%s cache retry %d/%d for %s (%.1fs): %s",
+                cache_label,
+                attempt + 1,
+                retry_count,
+                safe_url_for_log(url),
+                wait,
+                exc,
+            )
+            await asyncio.sleep(wait)
 
 
