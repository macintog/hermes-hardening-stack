+    @pytest.mark.asyncio
+    async def test_send_image_blocks_unsafe_safe_http_target_without_raw_url_send(self):
+        """SafeHTTP policy blocks should fail closed instead of sending the raw URL."""
+        blocked = SafeHTTPError("Blocked unsafe URL target: http://127.0.0.1/image.png")
+        mock_download = AsyncMock(side_effect=blocked)
+        self.adapter.send = AsyncMock()
+
+        with patch("plugins.platforms.mattermost.adapter.safe_download_bytes", mock_download):
+            result = await self.adapter.send_image(
+                "channel_1", "http://127.0.0.1/image.png", caption="A cat"
+            )
+
+        assert result.success is False
+        assert "Blocked unsafe URL target" in result.error
+        self.adapter.send.assert_not_called()
+        mock_download.assert_awaited_once()
+
+    @pytest.mark.asyncio
+    async def test_send_image_blocks_disallowed_content_type_without_raw_url_send(self):
+        """SafeHTTP content policy blocks should not fall back to a raw URL message."""
+        blocked = SafeHTTPError("Blocked disallowed content type text/html")
+        mock_download = AsyncMock(side_effect=blocked)
+        self.adapter.send = AsyncMock()
+
+        with patch("plugins.platforms.mattermost.adapter.safe_download_bytes", mock_download):
+            result = await self.adapter.send_image(
+                "channel_1", "https://img.example.com/cat.html", caption="A cat"
+            )
+
+        assert result.success is False
+        assert "Blocked disallowed content type text/html" in result.error
+        self.adapter.send.assert_not_called()
+        mock_download.assert_awaited_once()
+
+    @pytest.mark.asyncio
+    async def test_send_multiple_images_uses_safe_download_bytes(self):
+        class DownloadResult:
+            content = b"\x89PNG\x00fake-image-data"
+            content_type = "image/png"
+
+        mock_download = AsyncMock(return_value=DownloadResult())
+        self.adapter._upload_file = AsyncMock(return_value="file_abc123")
+        self.adapter._api_post = AsyncMock(return_value={"id": "post_with_files"})
+
+        with patch("plugins.platforms.mattermost.adapter.safe_download_bytes", mock_download):
+            await self.adapter.send_multiple_images(
+                "channel_1",
+                [("https://img.example.com/cat.png", "A cat")],
+            )
+
+        mock_download.assert_awaited_once()
+        kwargs = mock_download.await_args.kwargs
+        assert kwargs["source_type"] == "gateway:mattermost-url-file"
+        assert kwargs["policy"]["redirect_credentials"] == "no-credentials"
+        self.adapter._upload_file.assert_awaited_once_with(
+            "channel_1",
+            DownloadResult.content,
+            "cat.png",
+            "image/png",
+        )
+        self.adapter._api_post.assert_awaited_once()
+
+    @pytest.mark.asyncio
