+    def test_install_writes_provenance_sidecar_for_external_skill(self, tmp_path):
+        import tools.skills_hub as hub
+
+        hub_dir = tmp_path / "skills" / ".hub"
+        original_lock_file = hub.HubLockFile
+
+        class TempHubLockFile(original_lock_file):
+            def __init__(self, path=None):
+                super().__init__(path or hub.LOCK_FILE)
+
+        with patch.object(hub, "SKILLS_DIR", tmp_path / "skills"), \
+             patch.object(hub, "HUB_DIR", hub_dir), \
+             patch.object(hub, "LOCK_FILE", hub_dir / "lock.json"), \
+             patch.object(hub, "QUARANTINE_DIR", hub_dir / "quarantine"), \
+             patch.object(hub, "AUDIT_LOG", hub_dir / "audit.log"), \
+             patch.object(hub, "TAPS_FILE", hub_dir / "taps.json"), \
+             patch.object(hub, "INDEX_CACHE_DIR", hub_dir / "index-cache"), \
+             patch.object(hub, "HubLockFile", TempHubLockFile):
+            bundle = SkillBundle(
+                name="copied-skill",
+                files={"SKILL.md": "---\nname: copied-skill\n---\n\nBody\n"},
+                source="url",
+                identifier="https://example.com/skills/copied-skill/SKILL.md",
+                trust_level="community",
+            )
+            q_path = hub.quarantine_bundle(bundle)
+            install_dir = hub.install_from_quarantine(
+                q_path,
+                "copied-skill",
+                "",
+                bundle,
+                hub.ScanResult("copied-skill", "url", "community", "safe"),
+            )
+
+            sidecar = json.loads((install_dir / ".hermes_skill_provenance.json").read_text(encoding="utf-8"))
+            lock_entry = hub.HubLockFile(path=hub.LOCK_FILE).load()["installed"]["copied-skill"]
+
+        assert sidecar["source"] == "url"
+        assert sidecar["identifier"] == "https://example.com/skills/copied-skill/SKILL.md"
+        assert sidecar["provenance"]["source_type"] == "direct-url"
+        assert sidecar["provenance"]["authority"] == "evidence_only"
+        assert lock_entry["provenance"]["source_type"] == "direct-url"
+        assert lock_entry["provenance"]["authority"] == "evidence_only"
+
