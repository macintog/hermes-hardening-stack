+def _normalize_hook_policy(value: Any, default: str) -> str:
+    if not isinstance(value, str):
+        return default
+    normalized = value.strip().lower().replace("-", "_")
+    return normalized if normalized in VALID_HOOK_POLICIES else default
+
+
+def _configured_hook_policy(manifest: "PluginManifest", hook_name: str) -> str:
+    return _normalize_hook_policy(
+        manifest.hook_authority.get(hook_name),
+        HOOK_POLICY_DEFAULTS.get(hook_name, OBSERVE_ONLY_HOOK_POLICY),
+    )
+
+
+def _audit_plugin_hook_alteration(
+    manifest: "PluginManifest",
+    hook_name: str,
+    policy: str,
+    callback: Callable,
+    result: Any,
+) -> None:
+    logger.info(
+        "Trusted plugin hook altered Hermes execution/model-visible output: "
+        "plugin=%s key=%s source=%s hook=%s policy=%s callback=%s result_type=%s",
+        manifest.name,
+        manifest.key or manifest.name,
+        manifest.source,
+        hook_name,
+        policy,
+        getattr(callback, "__name__", repr(callback)),
+        type(result).__name__,
+    )
+
