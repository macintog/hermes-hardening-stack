+            get_channel=MagicMock(return_value=channel),
+            fetch_channel=AsyncMock(),
+        )
+
+        with patch(
+            "plugins.platforms.discord.adapter.safe_download_bytes",
+            new_callable=AsyncMock,
+            side_effect=SafeHTTPError("Blocked unsafe URL target: http://169.254.169.254/latest"),
+        ), patch.object(
+            DiscordAdapter.__mro__[1],
+            "send_image",
+            AsyncMock(return_value=SendResult(success=True, message_id="url-fallback")),
+        ) as base_send:
+            result = await adapter.send_image("123", "https://example.com/cat.png", "caption")
+
+        assert result.success is False
+        assert "Blocked unsafe URL target" in (result.error or "")
+        channel.send.assert_not_awaited()
+        base_send.assert_not_awaited()
+
