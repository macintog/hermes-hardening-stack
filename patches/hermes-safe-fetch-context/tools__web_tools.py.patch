+def _attach_web_search_evidence_ledger(response_data: Dict[str, Any], *, query: str, limit: int, backend: str) -> Dict[str, Any]:
+    """Attach compact native evidence provenance for untrusted search metadata."""
+    try:
+        from agent.evidence_ledgers import (
+            attach_evidence_ledger,
+            build_evidence_item,
+            build_tool_invocation,
+            text_byte_count,
+            text_sha256,
+        )
+
+        evidence_items = []
+        for idx, result in enumerate(response_data.get("data", {}).get("web", []) or []):
+            title = str(result.get("title") or "")
+            description = str(result.get("description") or "")
+            combined = "\n".join(part for part in (title, description) if part)
+            sha, status = text_sha256(combined) if combined else (None, "missing")
+            evidence_items.append(build_evidence_item(
+                kind="web_search_snippet",
+                source_type="web_search_result",
+                extraction_layer=f"web_search:{backend}",
+                text_ref=f"data.web[{idx}].title_description",
+                text=None,
+                verbatim=True,
+                content_type="text/plain",
+                source_uri=result.get("url"),
+                sha256=sha,
+                byte_count=text_byte_count(combined),
+                char_count=len(combined),
+                metadata={
+                    "position": result.get("position", idx + 1),
+                    "hash_status": status,
+                    "has_title": bool(title),
+                    "has_description": bool(description),
+                },
+            ))
+        return attach_evidence_ledger(
+            response_data,
+            tool_name="web_search",
+            evidence_items=evidence_items,
+            tool_invocation=build_tool_invocation(
+                name="web_search",
+                args={"query": query, "limit": limit},
+                read_only=True,
+                metadata={"backend": backend},
+            ),
+            metadata={"backend": backend},
+        )
+    except Exception as ledger_error:
+        logger.debug("Failed to attach web_search evidence ledger: %s", ledger_error)
+        return response_data
+
+
+def _attach_web_extract_evidence_ledger(
+    response_data: Dict[str, Any],
+    *,
+    urls: List[str],
+    format: str | None,
+    use_llm_processing: bool,
+    model: Optional[str],
+    min_length: int,
+    backend: str,
+    processed_urls: set[str] | None = None,
+    blocked: bool = False,
+    metadata: Dict[str, Any] | None = None,
+) -> Dict[str, Any]:
+    """Attach compact native evidence provenance for untrusted downloaded web text."""
+    try:
+        from agent.evidence_ledgers import (
+            attach_evidence_ledger,
+            build_evidence_item,
+            build_tool_invocation,
+            text_byte_count,
+            text_sha256,
+        )
+
+        processed_urls = processed_urls or set()
+        evidence_items = []
+        for idx, result in enumerate(response_data.get("results", []) or []):
+            content = str(result.get("content") or "")
+            url = str(result.get("url") or "")
+            processed = url in processed_urls
+            sha, status = text_sha256(content) if content else (None, "missing")
+            evidence_items.append(build_evidence_item(
+                kind="web_extract_summary" if processed else "downloaded_web_text",
+                source_type="downloaded_web_text",
+                extraction_layer=f"web_extract:{backend}",
+                text_ref=f"results[{idx}].content",
+                text=None,
+                verbatim=not processed,
+                content_type="text/markdown" if format in (None, "markdown") else "text/html",
+                source_uri=url,
+                sha256=sha,
+                byte_count=text_byte_count(content),
+                char_count=len(content),
+                metadata={
+                    "title_present": bool(result.get("title")),
+                    "error_present": bool(result.get("error")),
+                    "blocked_by_policy": bool(result.get("blocked_by_policy")),
+                    "hash_status": status,
+                    "llm_processing_requested": bool(use_llm_processing),
+                    "llm_processed": bool(processed),
+                },
+            ))
+        return attach_evidence_ledger(
+            response_data,
+            tool_name="web_extract",
+            evidence_items=evidence_items,
+            tool_invocation=build_tool_invocation(
+                name="web_extract",
+                args={
+                    "urls": urls,
+                    "format": format,
+                    "use_llm_processing": use_llm_processing,
+                    "model": model,
+                    "min_length": min_length,
+                },
+                read_only=True,
+                blocked=blocked,
+                metadata={"backend": backend},
+            ),
+            metadata={"backend": backend, **dict(metadata or {})},
+        )
+    except Exception as ledger_error:
+        logger.debug("Failed to attach web_extract evidence ledger: %s", ledger_error)
+        return response_data
+
+
