+def _attach_transcript_evidence_ledger(result: Dict[str, Any], *, file_path: str, model: Optional[str]) -> Dict[str, Any]:
+    """Attach compact provenance for untrusted audio-derived transcript text."""
+    if not result.get("success"):
+        return result
+    try:
+        from agent.evidence_ledgers import (
+            attach_evidence_ledger,
+            build_evidence_item,
+            build_tool_invocation,
+            file_byte_count,
+            file_sha256,
+        )
+
+        sha, status = file_sha256(file_path)
+        transcript = str(result.get("transcript") or "")
+        provider = str(result.get("provider") or "unknown")
+        return attach_evidence_ledger(
+            result,
+            tool_name="transcribe_audio",
+            evidence_items=[build_evidence_item(
+                kind="transcript_text",
+                source_type="audio_file",
+                extraction_layer=f"stt:{provider}",
+                text_ref="transcript",
+                text=None,
+                verbatim=True,
+                content_type="text/plain",
+                source_uri=file_path,
+                sha256=sha,
+                byte_count=file_byte_count(file_path),
+                char_count=len(transcript),
+                metadata={"provider": provider, "model": model, "hash_status": status},
+            )],
+            tool_invocation=build_tool_invocation(
+                name="transcribe_audio",
+                args={"path": file_path, "model": model},
+                read_only=True,
+                metadata={"provider": provider},
+            ),
+            metadata={"provider": provider},
+        )
+    except Exception as ledger_error:
+        logger.debug("Failed to attach transcription evidence ledger: %s", ledger_error)
+        return result
+
+
