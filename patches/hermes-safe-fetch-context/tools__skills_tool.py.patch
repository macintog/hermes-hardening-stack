+def _hub_lock_path() -> Path:
+    return SKILLS_DIR / ".hub" / "lock.json"
+
+
+def _trust_promotions_path() -> Path:
+    return SKILLS_DIR / ".hub" / "trust_promotions.json"
+
+
+def _skill_provenance_sidecar_path(skill_md: Path) -> Path:
+    skill_dir = skill_md.parent if skill_md.name == "SKILL.md" else skill_md
+    return skill_dir / ".hermes_skill_provenance.json"
+
+
+def _read_json_file(path: Path, fallback: Any) -> Any:
+    try:
+        if path.exists():
+            return json.loads(path.read_text(encoding="utf-8"))
+    except (json.JSONDecodeError, OSError):
+        pass
+    return fallback
+
+
+def _write_json_file(path: Path, data: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+
+
+def _hash_path(path: Path) -> str:
+    hasher = hashlib.sha256()
+    if path.is_file():
+        hasher.update(path.read_bytes())
+        return hasher.hexdigest()
+    for child in sorted(p for p in path.rglob("*") if p.is_file()):
+        try:
+            rel = child.relative_to(path).as_posix()
+        except ValueError:
+            rel = child.name
+        hasher.update(rel.encode("utf-8"))
+        hasher.update(b"\0")
+        hasher.update(child.read_bytes())
+        hasher.update(b"\0")
+    return hasher.hexdigest()
+
+
+def _load_trust_promotion(key: str, current_hash: str) -> Optional[Dict[str, Any]]:
+    data = _read_json_file(_trust_promotions_path(), {"version": 1, "skills": {}})
+    skills = data.get("skills") if isinstance(data, dict) else {}
+    entry = skills.get(key) if isinstance(skills, dict) else None
+    if not isinstance(entry, dict):
+        return None
+    promoted_hash = str(entry.get("content_hash") or "")
+    if promoted_hash and promoted_hash != current_hash:
+        return None
+    return entry
+
+
+def _matching_hub_lock_entry(skill_md: Path, resolved_name: str) -> Optional[Dict[str, Any]]:
+    data = _read_json_file(_hub_lock_path(), {"version": 1, "installed": {}})
+    installed = data.get("installed") if isinstance(data, dict) else {}
+    if not isinstance(installed, dict):
+        return None
+
+    skill_path = skill_md.parent if skill_md.name == "SKILL.md" else skill_md
+    try:
+        rel_dir = skill_path.resolve().relative_to(SKILLS_DIR.resolve()).as_posix()
+    except ValueError:
+        rel_dir = ""
+
+    by_name = installed.get(resolved_name)
+    if isinstance(by_name, dict):
+        return by_name
+
+    for name, entry in installed.items():
+        if not isinstance(entry, dict):
+            continue
+        install_path = str(entry.get("install_path") or "")
+        if install_path and (rel_dir == install_path or rel_dir.startswith(f"{install_path}/")):
+            return {"name": name, **entry}
+    return None
+
+
+def _sidecar_authority_metadata(skill_md: Path) -> Optional[Dict[str, Any]]:
+    data = _read_json_file(_skill_provenance_sidecar_path(skill_md), {})
+    if not isinstance(data, dict):
+        return None
+    provenance = data.get("provenance") if isinstance(data.get("provenance"), dict) else {}
+    source_type = str(provenance.get("source_type") or data.get("source_type") or "")
+    if not source_type:
+        return None
+    authority = str(provenance.get("authority") or "")
+    if source_type == "bundled":
+        authority = "trusted_by_local_policy"
+    elif authority != "trusted_by_local_policy":
+        authority = "evidence_only"
+    return {
+        "provenance": source_type,
+        "authority": authority,
+        "promotion_required": authority == "evidence_only",
+        "installed_source": data.get("source"),
+        "installed_identifier": data.get("identifier"),
+        "sidecar_provenance": True,
+    }
+
+
+def _authority_metadata_for_skill(
+    skill_md: Path,
+    resolved_name: str,
+    *,
+    plugin_key: str | None = None,
+) -> Dict[str, Any]:
+    if plugin_key:
+        current_hash = _hash_path(skill_md)
+        promotion = _load_trust_promotion(plugin_key, current_hash)
+        if promotion:
+            return {
+                "provenance": "manually-promoted",
+                "authority": "trusted_by_local_policy",
+                "trust_promotion": promotion,
+            }
+        return {
+            "provenance": "plugin",
+            "authority": "evidence_only",
+            "promotion_required": True,
+        }
+
+    try:
+        skill_md.resolve().relative_to(SKILLS_DIR.resolve())
+        inside_skills_dir = True
+    except ValueError:
+        inside_skills_dir = False
+
+    if not inside_skills_dir:
+        return {
+            "provenance": "external",
+            "authority": "evidence_only",
+            "promotion_required": True,
+        }
+
+    entry = _matching_hub_lock_entry(skill_md, resolved_name)
+    current_hash = _hash_path(skill_md.parent if skill_md.name == "SKILL.md" else skill_md)
+    promotion = _load_trust_promotion(resolved_name, current_hash)
+    if promotion:
+        return {
+            "provenance": "manually-promoted",
+            "authority": "trusted_by_local_policy",
+            "trust_promotion": promotion,
+        }
+
+    if not entry:
+        sidecar = _sidecar_authority_metadata(skill_md)
+        if sidecar:
+            return sidecar
+        return {
+            "provenance": "local-authored",
+            "authority": "trusted_by_local_policy",
+        }
+
+    provenance = entry.get("provenance") if isinstance(entry, dict) else {}
+    if isinstance(provenance, dict):
+        source_type = str(provenance.get("source_type") or "")
+        authority = str(provenance.get("authority") or "")
+    else:
+        source_type = ""
+        authority = ""
+    if not source_type:
+        if entry.get("source") == "official" or entry.get("trust_level") == "builtin":
+            source_type = "bundled"
+        elif entry.get("source") == "url":
+            source_type = "direct-url"
+        else:
+            source_type = "community-hub"
+    if source_type == "bundled":
+        authority = "trusted_by_local_policy"
+    elif authority != "trusted_by_local_policy":
+        authority = "evidence_only"
+    return {
+        "provenance": source_type,
+        "authority": authority,
+        "promotion_required": authority == "evidence_only",
+        "installed_source": entry.get("source"),
+        "installed_identifier": entry.get("identifier"),
+    }
+
+
+def skill_trust_promote(
+    name: str,
+    promoted_by: str = "local-user",
+    reason: str = "",
+) -> str:
+    """Promote an installed or plugin-provided skill to trusted local policy."""
+    try:
+        loaded = json.loads(skill_view(name, preprocess=False))
+    except Exception as exc:
+        return tool_error(f"Could not load skill '{name}' for promotion: {exc}", success=False)
+    if not loaded.get("success"):
+        return json.dumps(loaded, ensure_ascii=False)
+
+    skill_dir_raw = loaded.get("skill_dir")
+    target_path = Path(skill_dir_raw) if skill_dir_raw else None
+    if target_path is None or not target_path.exists():
+        return tool_error(f"Skill '{name}' has no promotable local path.", success=False)
+
+    key = str(loaded.get("name") or name)
+    if ":" in name:
+        key = name
+        target_path = target_path / "SKILL.md"
+    current_hash = _hash_path(target_path)
+    promoted_at = datetime.now(timezone.utc).isoformat()
+    entry = {
+        "promoted_at": promoted_at,
+        "promoted_by": str(promoted_by or "local-user"),
+        "reason": str(reason or ""),
+        "content_hash": current_hash,
+    }
+
+    data = _read_json_file(_trust_promotions_path(), {"version": 1, "skills": {}})
+    if not isinstance(data, dict):
+        data = {"version": 1, "skills": {}}
+    skills = data.setdefault("skills", {})
+    if isinstance(skills, dict):
+        skills[key] = entry
+    _write_json_file(_trust_promotions_path(), data)
+
+    try:
+        from tools.skills_hub import HubLockFile
+
+        HubLockFile(_hub_lock_path()).record_promotion(
+            key,
+            promoted_by=entry["promoted_by"],
+            reason=entry["reason"],
+            skill_hash=current_hash,
+        )
+    except Exception:
+        logger.debug("Could not mirror skill trust promotion into hub lock", exc_info=True)
+
+    return json.dumps(
+        {
+            "success": True,
+            "name": key,
+            "authority": "trusted_by_local_policy",
+            "provenance": "manually-promoted",
+            "trust_promotion": entry,
+        },
+        ensure_ascii=False,
+    )
+
