+        cwd=tmp_path,
+        context_length=100_000,
+        url_fetcher=lambda _url: payload,
+    )
+
+    assert result.expanded is True
+    assert expected in result.message
+    assert '<untrusted-context source="downloaded_text"' in result.message
+    assert result.message.count("<untrusted-context") == 1
