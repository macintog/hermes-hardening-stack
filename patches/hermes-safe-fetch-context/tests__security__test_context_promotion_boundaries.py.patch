+    )
+
+    result = await preprocess_context_references_async(
+        message,
+        cwd=tmp_path,
+        context_length=100_000,
+        trusted_user_intent="Summarize the page.",
+    )
+
+    assert result.expanded is True
+    assert "local reference expansion requires trusted active-user authority" in result.message
+    assert "PRIVATE LOCAL BYTES" not in result.message
