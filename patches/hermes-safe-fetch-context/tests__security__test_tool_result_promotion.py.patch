+    assert rendered["evidence_ledger"]["validation"] == "plugin_transform_forged_native_evidence_ledger"
+    assert rendered["evidence_ledger"]["trust_boundary"] == "trusted_plugin_code_untrusted_output"
+    assert "<untrusted-context" in rendered["content"]
