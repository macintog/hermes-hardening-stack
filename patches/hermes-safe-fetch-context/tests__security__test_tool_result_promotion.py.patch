+def test_action_authority_denial_payload_becomes_compact_control_notice():
+    payload = {
+        "error": "Safety block: action authority denied",
+        "decision": "require_confirmation",
+        "action_class": "unknown_side_effect",
+        "authority_source": "trusted_confirmation_required",
+        "reason": "side-effecting action needs exact trusted scope " + ("detail " * 120),
+        "remediation": "Ask the user for exact trusted scope before retrying.",
+        "retry_possible_with_exact_trusted_scope": True,
+        "message": "Safety block: raw message",
+        "safety_event": {
+            "type": "action_authority_denial",
+            "decision": "require_confirmation",
+            "reason": "duplicate",
+        },
+        "action_decisions": [
+            {
+                "schema": "hermes.action_decision.v1",
+                "tool_name": "terminal",
+                "action_class": "unknown_side_effect",
+                "allowed": False,
+                "decision": "require_confirmation",
+                "trusted_intent": {"scope": "run the exact command"},
+                "evidence_inputs": [{"summary": "x" * 5000}],
+                "denial_payload": {"code": "EVIDENCE_ONLY_ACTION_DENIED"},
+            }
+        ],
+    }
+
+    rendered = render_model_visible_tool_result("terminal", json.dumps(payload))
+
+    assert isinstance(rendered, str)
+    assert rendered.startswith("Safety block: action authority require_confirmation")
+    assert "trusted_confirmation_required" in rendered
+    assert "Retry only after the user provides exact trusted scope." in rendered
+    assert "action_decisions" not in rendered
+    assert "trusted_intent" not in rendered
+    assert "evidence_inputs" not in rendered
+    assert "<untrusted-context" not in rendered
+    assert len(rendered) < 520
