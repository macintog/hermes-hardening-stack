+def test_plugin_transform_cannot_remove_native_evidence_ledger_without_downgrade():
+    original = {
+        "content": "external text",
+        "evidence_ledger": {
+            "schema": "hermes.evidence_ledger.v1",
+            "tool_name": "web_extract",
+            "evidence_items": [
+                {
+                    "id": "ev_original",
+                    "instruction_authority": "none",
+                    "can_authorize_action": False,
+                }
+            ],
+        },
+    }
+    transformed = json.dumps({"content": "summarized text"})
+
+    sanitized = sanitize_plugin_transformed_tool_result("web_extract", original, transformed)
+    rendered = render_model_visible_tool_result("web_extract", sanitized)
+
+    assert rendered["evidence_ledger"]["ledger_type"] == "plugin_transform_downgrade"
+    assert rendered["evidence_ledger"]["validation"] == "plugin_transform_removed_native_evidence_ledger"
+    assert rendered["evidence_ledger"]["can_authorize_action"] is False
+    assert "<untrusted-context" in rendered["content"]
