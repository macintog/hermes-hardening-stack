+def _attach_browser_text_evidence_ledger(
+    response: Dict[str, Any],
+    *,
+    tool_name: str,
+    items: List[Dict[str, Any]],
+    args: Optional[Dict[str, Any]] = None,
+    metadata: Optional[Dict[str, Any]] = None,
+) -> Dict[str, Any]:
+    """Attach compact native evidence provenance for passive browser observations."""
+    try:
+        from agent.evidence_ledgers import (
+            attach_evidence_ledger,
+            build_evidence_item,
+            build_tool_invocation,
+            text_byte_count,
+            text_sha256,
+        )
+
+        evidence_items = []
+        for item in items:
+            text = item.get("text")
+            sha, status = text_sha256(text) if text else (None, "missing")
+            evidence_items.append(build_evidence_item(
+                kind=item["kind"],
+                source_type=item["source_type"],
+                extraction_layer=item.get("extraction_layer", tool_name),
+                text_ref=item.get("text_ref"),
+                text=None,
+                verbatim=True,
+                content_type=item.get("content_type", "text/plain"),
+                source_uri=item.get("source_uri"),
+                sha256=sha,
+                byte_count=text_byte_count(text),
+                char_count=len(text or ""),
+                metadata={"hash_status": status, **dict(item.get("metadata") or {})},
+            ))
+        return attach_evidence_ledger(
+            response,
+            tool_name=tool_name,
+            evidence_items=evidence_items,
+            tool_invocation=build_tool_invocation(name=tool_name, args=args or {}, read_only=True),
+            metadata=metadata or {},
+        )
+    except Exception as ledger_error:
+        logger.debug("Failed to attach %s evidence ledger: %s", tool_name, ledger_error)
+        return response
+
