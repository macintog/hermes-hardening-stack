+def test_model_tools_unknown_side_effect_requires_confirmation_before_dispatch(monkeypatch):
+    from model_tools import handle_function_call, registry
+
+    called = False
+
+    def fake_tool(args, **kwargs):
+        nonlocal called
+        called = True
+        return json.dumps({"ok": True})
+
+    registry.register("unclassified_dynamic_tool", "plugin", {"description": "dynamic"}, fake_tool)
+    try:
+        result = handle_function_call(
+            "unclassified_dynamic_tool",
+            {"payload": "send it"},
+            user_task="Please help with this task.",
+            skip_pre_tool_call_hook=True,
+        )
+    finally:
+        registry.deregister("unclassified_dynamic_tool")
+    payload = json.loads(result)
+    assert payload["decision"] == "require_confirmation"
+    assert payload["action_class"] == "unknown_side_effect"
+    assert payload["error"] == "Safety block: action authority denied"
+    assert "message" in payload
+    decision = payload["action_decisions"][0]
+    assert decision["schema"] == "hermes.action_decision.v1"
+    assert decision["allowed"] is False
+    assert decision["decision"] == "require_confirmation"
+    assert decision["action_class"] == "unknown_side_effect"
+    assert "denial_payload" in decision
+    assert called is False
+
