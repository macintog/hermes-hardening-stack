+def _truncate_preserving_untrusted_context(block: str, max_chars: int) -> str | None:
+    opening_start = block.find("<untrusted-context")
+    closing_start = block.rfind("</untrusted-context>")
+    if opening_start < 0 or closing_start < 0 or closing_start < opening_start:
+        return None
+    opening_end = block.find(">", opening_start)
+    if opening_end < 0:
+        return None
+    suffix = block[closing_start:]
+    prefix_budget = max_chars - len(_TRUNCATED_REFERENCE_MARKER) - len(suffix)
+    if prefix_budget <= opening_end + 1:
+        return None
+    return block[:prefix_budget] + _TRUNCATED_REFERENCE_MARKER + suffix
 
 
