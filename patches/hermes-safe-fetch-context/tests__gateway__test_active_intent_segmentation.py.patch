+def test_gateway_proxy_active_intent_signature_headers_cover_request_body(monkeypatch):
+    monkeypatch.setenv("HERMES_GATEWAY_ACTIVE_INTENT_SECRET", "test-active-intent-secret")
+    raw_body = json.dumps(
+        {
+            "model": "hermes-agent",
+            "messages": [
+                {
+                    "role": "user",
+                    "content": "trusted typed text",
+                    "__active_user_intent": _gateway_active_intent_marker("trusted typed text", []),
+                }
+            ],
+            "stream": True,
+        },
+        separators=(",", ":"),
+        ensure_ascii=False,
+    ).encode("utf-8")
+
+    headers = _gateway_active_intent_signature_headers(raw_body)
+    payload = b"\n".join([
+        b"hermes-gateway-active-intent-v2",
+        headers["X-Hermes-Gateway-Active-Intent-Timestamp"].encode("utf-8"),
+        headers["X-Hermes-Gateway-Active-Intent-Nonce"].encode("utf-8"),
+        raw_body,
+    ])
+    expected = hmac.new(b"test-active-intent-secret", payload, hashlib.sha256).hexdigest()
+
+    assert headers["X-Hermes-Gateway-Active-Intent"] == "hermes-gateway-remote-proxy-v2"
+    assert headers["X-Hermes-Gateway-Active-Intent-Signature"] == expected
+
