+@pytest.mark.asyncio
+async def test_gateway_proxy_sends_signed_raw_body_when_active_intent_present(monkeypatch):
+    monkeypatch.setenv("GATEWAY_PROXY_URL", "http://host:8642")
+    monkeypatch.setenv("HERMES_GATEWAY_ACTIVE_INTENT_SECRET", "test-active-intent-secret")
+
+    class FakeResponse:
+        status = 200
+
+        def __init__(self):
+            self.content = self
+
+        async def iter_any(self):
+            yield b'data: {"choices":[{"delta":{"content":"ok"}}]}\n\n'
+            yield b"data: [DONE]\n\n"
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *args):
+            return False
+
+    class FakeSession:
+        def __init__(self):
+            self.captured_data = None
+            self.captured_json = None
+            self.captured_headers = None
+
+        def post(self, _url, data=None, json=None, headers=None, **_kwargs):
+            self.captured_data = data
+            self.captured_json = json
+            self.captured_headers = headers
+            return FakeResponse()
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *args):
+            return False
+
+    runner = _make_runner()
+    runner._session_run_generation = {}
+    session = FakeSession()
+    active_intent = _gateway_active_intent_marker("trusted typed text", [])
+
+    with patch("gateway.run._load_gateway_config", return_value={}):
+        with patch("aiohttp.ClientSession", return_value=session):
+            with patch("aiohttp.ClientTimeout"):
+                result = await runner._run_agent_via_proxy(
+                    message="trusted typed text",
+                    context_prompt="",
+                    history=[],
+                    source=_source(),
+                    session_id="session-abc",
+                    active_user_intent=active_intent,
+                )
+
+    assert result["final_response"] == "ok"
+    assert session.captured_json is None
+    assert isinstance(session.captured_data, bytes)
+    body = json.loads(session.captured_data.decode("utf-8"))
+    assert body["messages"][0]["__active_user_intent"] == active_intent
+    assert session.captured_headers["X-Hermes-Gateway-Active-Intent"] == "hermes-gateway-remote-proxy-v2"
+    assert "X-Hermes-Gateway-Active-Intent-Signature" in session.captured_headers
+
