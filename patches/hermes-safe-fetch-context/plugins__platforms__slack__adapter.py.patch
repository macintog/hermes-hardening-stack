+def _is_slack_file_origin(url: str) -> bool:
+    host = (urlparse(url).hostname or "").lower()
+    return host == "files.slack.com" or host.endswith(".files.slack.com")
+
+
+def _is_non_retryable_safe_http_error(exc: SafeHTTPError) -> bool:
+    message = str(exc)
+    if "HTTP status 429" in message:
+        return False
+    return "HTTP status 4" in message or "Blocked " in message
 
