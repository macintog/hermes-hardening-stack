+    @staticmethod
+    def _gateway_active_intent_secret() -> str:
+        return (
+            os.getenv("HERMES_GATEWAY_ACTIVE_INTENT_SECRET", "").strip()
+            or os.getenv("GATEWAY_ACTIVE_INTENT_SECRET", "").strip()
