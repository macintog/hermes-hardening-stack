+
+    @classmethod
+    def _gateway_active_intent_signature(cls, raw_body: bytes, *, timestamp: str, nonce: str, secret: str) -> str:
+        payload = b"\n".join([
+            b"hermes-gateway-active-intent-v2",
+            timestamp.encode("utf-8"),
+            nonce.encode("utf-8"),
+            raw_body,
+        ])
+        return hmac.new(secret.encode("utf-8"), payload, hashlib.sha256).hexdigest()
+
+    async def _parse_json_request_body(self, request: "web.Request") -> tuple[Optional[Dict[str, Any]], bytes, Optional["web.Response"]]:
+        try:
+            raw_body = await request.read()
+            parsed = json.loads(raw_body.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError, Exception):
+            return None, b"", web.json_response(_openai_error("Invalid JSON in request body"), status=400)
+        if not isinstance(parsed, dict):
+            return None, raw_body, web.json_response(_openai_error("Request body must be a JSON object"), status=400)
+        return parsed, raw_body, None
+
+    def _prune_gateway_active_intent_nonces(self, now: float) -> None:
+        nonces = getattr(self, "_gateway_active_intent_nonces", None)
+        if nonces is None:
+            nonces = {}
+            self._gateway_active_intent_nonces = nonces
+        cutoff = now - self._GATEWAY_ACTIVE_INTENT_MAX_CLOCK_SKEW_SECONDS
+        for nonce, seen_at in list(nonces.items()):
+            if seen_at < cutoff or len(nonces) > self._GATEWAY_ACTIVE_INTENT_MAX_NONCES:
+                nonces.pop(nonce, None)
+
+    def _verify_gateway_active_intent_signature(self, request: "web.Request", raw_body: bytes) -> Optional[str]:
+        """Return an error message when a body marker has an invalid internal signature."""
+        if not hmac.compare_digest(
+            request.headers.get(self._GATEWAY_ACTIVE_INTENT_HEADER, ""),
+            self._GATEWAY_ACTIVE_INTENT_HEADER_VALUE,
+        ):
+            return "Missing gateway active-intent signature"
+        secret = self._gateway_active_intent_secret()
+        if not secret:
+            return "Gateway active-intent secret is not configured"
+        timestamp = request.headers.get(self._GATEWAY_ACTIVE_INTENT_TIMESTAMP_HEADER, "").strip()
+        nonce = request.headers.get(self._GATEWAY_ACTIVE_INTENT_NONCE_HEADER, "").strip()
+        signature = request.headers.get(self._GATEWAY_ACTIVE_INTENT_SIGNATURE_HEADER, "").strip()
+        if not timestamp or not nonce or not signature:
+            return "Incomplete gateway active-intent signature"
+        try:
+            timestamp_value = int(timestamp)
+        except ValueError:
+            return "Invalid gateway active-intent timestamp"
+        now = time.time()
+        if abs(now - timestamp_value) > self._GATEWAY_ACTIVE_INTENT_MAX_CLOCK_SKEW_SECONDS:
+            return "Stale gateway active-intent signature"
+        if len(nonce) > 128:
+            return "Invalid gateway active-intent nonce"
+        self._prune_gateway_active_intent_nonces(now)
+        nonces = getattr(self, "_gateway_active_intent_nonces", {})
+        if nonce in nonces:
+            return "Replayed gateway active-intent signature"
+        expected = self._gateway_active_intent_signature(raw_body, timestamp=timestamp, nonce=nonce, secret=secret)
+        if not hmac.compare_digest(signature, expected):
+            return "Invalid gateway active-intent signature"
+        nonces[nonce] = now
+        return None
+
+    @staticmethod
+    def _contains_gateway_active_intent_marker(items: Any) -> bool:
+        if isinstance(items, dict):
+            return "__active_user_intent" in items
+        if isinstance(items, list):
+            return any(isinstance(item, dict) and "__active_user_intent" in item for item in items)
+        return False
+
+    def _body_has_signed_gateway_active_intent(self, request: "web.Request", raw_body: bytes, body: Dict[str, Any], container_key: str) -> tuple[bool, Optional["web.Response"]]:
+        if not self._contains_gateway_active_intent_marker(body.get(container_key)):
+            return False, None
+        signature = request.headers.get(self._GATEWAY_ACTIVE_INTENT_SIGNATURE_HEADER, "").strip()
+        if not signature:
+            return False, None
+        error = self._verify_gateway_active_intent_signature(request, raw_body)
+        if error:
+            return False, web.json_response(_openai_error(error), status=400)
+        return True, None
+
+    def _normalize_gateway_active_intent_marker(self, marker: Any) -> Dict[str, Any]:
+        """Validate and normalize the internal active-intent marker shape."""
+        if not isinstance(marker, dict):
+            raise ValueError("__active_user_intent must be an object")
+
+        normalized: Dict[str, Any] = {}
+        active_text = marker.get("active_text", "")
+        if active_text is not None:
+            if not isinstance(active_text, str):
+                raise ValueError("__active_user_intent.active_text must be a string")
+            if len(active_text) > self._MAX_ACTIVE_INTENT_TEXT_CHARS:
+                raise ValueError("__active_user_intent.active_text is too large")
+            normalized["active_text"] = active_text
+
+        evidence_text = marker.get("evidence_text")
+        if evidence_text is not None:
+            if not isinstance(evidence_text, str):
+                raise ValueError("__active_user_intent.evidence_text must be a string")
+            if len(evidence_text) > self._MAX_ACTIVE_INTENT_EVIDENCE_CHARS:
+                raise ValueError("__active_user_intent.evidence_text is too large")
+            normalized["evidence_text"] = evidence_text
+
+        raw_segments = marker.get("segments", [])
+        if raw_segments is None:
+            raw_segments = []
+        if not isinstance(raw_segments, list):
+            raise ValueError("__active_user_intent.segments must be an array")
+        if len(raw_segments) > self._MAX_ACTIVE_INTENT_SEGMENTS:
+            raise ValueError("__active_user_intent.segments has too many entries")
+
+        segments: List[Dict[str, Any]] = []
+        total_segment_text = 0
+        for idx, segment in enumerate(raw_segments):
+            if not isinstance(segment, dict):
+                raise ValueError(f"__active_user_intent.segments[{idx}] must be an object")
+            text = segment.get("text", "")
+            if not isinstance(text, str):
+                raise ValueError(f"__active_user_intent.segments[{idx}].text must be a string")
+            total_segment_text += len(text)
+            if total_segment_text > self._MAX_ACTIVE_INTENT_EVIDENCE_CHARS:
+                raise ValueError("__active_user_intent.segments text is too large")
+            trusted = segment.get("trusted_for_authority", False)
+            if not isinstance(trusted, bool):
+                raise ValueError(f"__active_user_intent.segments[{idx}].trusted_for_authority must be a boolean")
+            normalized_segment: Dict[str, Any] = {
+                "text": text,
+                "trusted_for_authority": trusted,
+            }
+            for key in ("kind", "surface", "source_label"):
+                value = segment.get(key)
+                if value is None:
+                    continue
+                if not isinstance(value, str):
+                    raise ValueError(f"__active_user_intent.segments[{idx}].{key} must be a string")
+                if len(value) > 256:
+                    raise ValueError(f"__active_user_intent.segments[{idx}].{key} is too large")
+                normalized_segment[key] = value
+            segments.append(normalized_segment)
+
+        normalized["segments"] = segments
+        trusted_segment_texts = [segment["text"] for segment in segments if segment.get("trusted_for_authority")]
+        active_text_value = normalized.get("active_text", "")
+        joined_trusted_text = "\n\n".join(text for text in trusted_segment_texts if text)
+        if active_text_value and segments:
+            if active_text_value not in trusted_segment_texts and active_text_value != joined_trusted_text:
+                raise ValueError("__active_user_intent.active_text must match trusted active-intent segments")
+        elif joined_trusted_text:
+            normalized["active_text"] = joined_trusted_text
+        if "active_text" not in normalized and not segments and "evidence_text" not in normalized:
+            raise ValueError("__active_user_intent must include active_text, evidence_text, or segments")
+        return normalized
