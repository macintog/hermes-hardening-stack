+from __future__ import annotations
+
+
+def test_direct_cli_short_quiet_flag_is_normalized_before_fire_parse():
+    import cli
+
+    argv = [
+        "cli.py",
+        "-Q",
+        "--toolsets",
+        "terminal",
+        "-q",
+        "Say OK only.",
+    ]
+    assert cli._normalize_fire_argv(argv) == [
+        "cli.py",
+        "--quiet",
+        "--toolsets",
+        "terminal",
+        "-q",
+        "Say OK only.",
+    ]
