+async def test_download_to_file_streams_without_retaining_body(monkeypatch):
+    monkeypatch.setattr(safe_http, "is_safe_url", lambda _url: True)
+    chunks_yielded = []
+
+    class ChunkedStream(httpx.AsyncByteStream):
