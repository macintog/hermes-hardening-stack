+def test_action_decision_payload_preserves_explicit_trusted_intent_presence():
+    decision = ActionAuthorityResult(
+        AuthorityDecision.ALLOW,
+        ActionClass.READ_ONLY_NETWORK_FETCH,
+        source="trusted_scoped_intent",
+    )
+
+    payload = decision.to_action_decision_payload(
+        "web_fetch",
+        trusted_intent={"present": True, "source": "user", "scope": "fetch https://example.com"},
+    )
+
+    assert payload["trusted_intent"]["present"] is True
+    assert payload["trusted_intent"]["source"] == "user"
+    assert payload["trusted_intent"]["scope"] == "fetch https://example.com"
