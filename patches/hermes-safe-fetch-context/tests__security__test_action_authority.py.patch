+    )
+    payload = decision.to_error_payload()
+    rendered = json.dumps(payload)
+    assert decision.decision == AuthorityDecision.BLOCK
+    assert payload["error"] == "Safety block: action authority denied"
+    assert payload["decision"] == AuthorityDecision.BLOCK.value
+    assert payload["action_class"] == ActionClass.SECRET_TRANSMISSION.value
+    assert payload["authority_source"] == "untrusted_context"
+    assert "untrusted" in payload["reason"]
+    assert "exact" in payload["remediation"]
+    assert payload["retry_possible_with_exact_trusted_scope"] is True
+    assert payload["safety_event"] == {
+        "type": "action_authority_denial",
+        "decision": AuthorityDecision.BLOCK.value,
+        "action_class": ActionClass.SECRET_TRANSMISSION.value,
+        "reason": payload["reason"],
+        "authority_source": "untrusted_context",
+        "remediation": payload["remediation"],
+        "retry_possible_with_exact_trusted_scope": True,
+    }
+    assert secret not in rendered
