+        evidence_inputs=[{"evidence_id": "ev_web", "source_type": "downloaded_web_text", "evidence_only": True}],
+    )
+
+    assert payload["schema"] == "hermes.action_decision.v1"
+    assert payload["tool_name"] == "send_email"
+    assert payload["action_class"] == ActionClass.OUTBOUND_MESSAGE.value
+    assert payload["allowed"] is False
+    assert payload["decision"] == AuthorityDecision.BLOCK.value
