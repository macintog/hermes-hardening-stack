+def test_development_repo_override_can_allow_commit_only_when_explicit(monkeypatch, tmp_path):
+    repo = enable_dev_override(monkeypatch, tmp_path)
+    denied = evaluate_action_authority(
+        "terminal",
+        {"command": "git commit -m hardening", "workdir": str(repo)},
+        trusted_user_intent="Continue hardening development.",
+    )
+    assert denied.decision == AuthorityDecision.BLOCK
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY_ALLOW_COMMIT", "1")
+    allowed = evaluate_action_authority(
+        "terminal",
+        {"command": "git commit -m hardening", "workdir": str(repo)},
+        trusted_user_intent="Continue hardening development.",
+    )
+    assert allowed.decision == AuthorityDecision.ALLOW
+
