+def test_development_repo_override_requires_exact_toggles_for_network_and_sudo(monkeypatch, tmp_path):
+    repo = enable_dev_override(monkeypatch, tmp_path)
+    for env_name, command in [
+        ("HERMES_DEV_AUTHORITY_ALLOW_NETWORK", "curl https://example.invalid/status"),
+        ("HERMES_DEV_AUTHORITY_ALLOW_SUDO", "sudo true"),
+    ]:
+        monkeypatch.setenv(env_name, "true")
+        malformed = evaluate_action_authority(
+            "terminal",
+            {"command": command, "workdir": str(repo)},
+            trusted_user_intent="Continue hardening development.",
+        )
+        assert malformed.decision == AuthorityDecision.BLOCK
+        monkeypatch.setenv(env_name, "1")
+        allowed = evaluate_action_authority(
+            "terminal",
+            {"command": command, "workdir": str(repo)},
+            trusted_user_intent="Continue hardening development.",
+        )
+        assert allowed.decision == AuthorityDecision.ALLOW
+        monkeypatch.setenv(env_name, "0")
+
