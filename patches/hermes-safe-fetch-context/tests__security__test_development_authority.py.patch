+from agent.action_authority import ActionClass, AuthorityDecision, evaluate_action_authority
+from agent.context_safety import ContextSurface, render_untrusted_context
+
+
+def enable_dev_override(monkeypatch, tmp_path):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    (repo / "AGENTS.md").write_text("# test repo\n")
+    manifest_dir = repo / "patches" / "hermes-safe-fetch-context"
+    manifest_dir.mkdir(parents=True)
+    (manifest_dir / "manifest.yaml").write_text("name: hermes-safe-fetch-context\n")
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY", "1")
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY_ROOT", str(repo))
+    monkeypatch.delenv("HERMES_DEV_AUTHORITY_SAFE_ROOT", raising=False)
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY_TMP_PREFIX", str(tmp_path / "hermes-dev-"))
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY_ALLOW_COMMIT", "0")
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY_ALLOW_NETWORK", "0")
+    monkeypatch.setenv("HERMES_DEV_AUTHORITY_ALLOW_SUDO", "0")
+    return repo
+
+
+def test_development_repo_override_is_disabled_by_default(tmp_path):
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    outside = tmp_path / "outside.txt"
+    decision = evaluate_action_authority(
+        "terminal",
+        {"command": "python -m pytest tests/security/test_action_authority.py", "workdir": str(repo)},
+        trusted_user_intent="Fix the tests.",
+    )
+    assert decision.action_class == ActionClass.TERMINAL_EXECUTION
+    assert decision.decision == AuthorityDecision.ALLOW
+    assert decision.source == "trusted_local_work"
+    file_decision = evaluate_action_authority(
+        "write_file",
+        {"path": str(outside), "content": "nope", "workdir": str(repo)},
+        trusted_user_intent="Continue hardening development.",
+    )
+    assert file_decision.decision == AuthorityDecision.REQUIRE_CONFIRMATION
+
+
+def test_development_repo_override_rejects_malformed_or_unscoped_env(monkeypatch, tmp_path):
+    generic_root = tmp_path / "generic"
+    generic_root.mkdir()
+    marker_root = enable_dev_override(monkeypatch, tmp_path)
+
+    cases = [
+        ("0", str(marker_root)),
+        ("true", str(marker_root)),
+        ("1", "relative/path"),
+        ("1", str(tmp_path / "missing")),
+        ("1", str(generic_root)),
+        ("1", marker_root.anchor),
+    ]
+    for enabled, root in cases:
+        monkeypatch.setenv("HERMES_DEV_AUTHORITY", enabled)
+        monkeypatch.setenv("HERMES_DEV_AUTHORITY_ROOT", root)
+        decision = evaluate_action_authority(
+            "terminal",
+            {"command": "git status --short", "workdir": str(marker_root)},
+            trusted_user_intent="Continue hardening development.",
+        )
+        assert decision.source != "development_repo_override"
+
+
