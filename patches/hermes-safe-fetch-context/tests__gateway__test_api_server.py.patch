+def _signed_active_intent_request(body: dict, *, secret: str = "test-active-intent-secret", timestamp: int | None = None, nonce: str = "nonce-1") -> tuple[bytes, dict[str, str]]:
+    raw_body = json.dumps(body, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+    timestamp_text = str(int(time.time()) if timestamp is None else timestamp)
+    headers = {
+        "Content-Type": "application/json",
+        "X-Hermes-Gateway-Active-Intent": "hermes-gateway-remote-proxy-v2",
+        "X-Hermes-Gateway-Active-Intent-Timestamp": timestamp_text,
+        "X-Hermes-Gateway-Active-Intent-Nonce": nonce,
+    }
+    headers["X-Hermes-Gateway-Active-Intent-Signature"] = APIServerAdapter._gateway_active_intent_signature(
+        raw_body,
+        timestamp=timestamp_text,
+        nonce=nonce,
+        secret=secret,
+    )
+    return raw_body, headers
+
