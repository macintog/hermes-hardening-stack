 _providers: Dict[str, BrowserProvider] = {}
 _lock = threading.Lock()
+_BUNDLED_PROVIDER_MODULE_PREFIX = "plugins.browser."
+_BROWSER_PROVIDER_REQUIRED_MEMBERS = (
+    "is_available",
+    "create_session",
+    "close_session",
+    "emergency_cleanup",
+)
+
+
+def _is_browser_provider_compatible(provider: object) -> bool:
+    """Accept real providers and duplicate-ABC bundled providers."""
+    if isinstance(provider, BrowserProvider):
+        return True
+    if not type(provider).__module__.startswith(_BUNDLED_PROVIDER_MODULE_PREFIX):
+        return False
+    name = getattr(provider, "name", None)
+    if not isinstance(name, str) or not name.strip():
+        return False
+    return all(
+        callable(getattr(provider, member, None))
+        for member in _BROWSER_PROVIDER_REQUIRED_MEMBERS
+    )
 
 
 def register_provider(provider: BrowserProvider) -> None:
