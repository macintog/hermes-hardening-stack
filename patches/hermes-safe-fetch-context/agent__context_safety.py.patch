+def classify_tool_result_surface(tool_name: str) -> ContextSurface:
+    """Classify model-visible string tool output provenance.
+
+    Tool results are untrusted evidence by default. Explicit entries and name
+    patterns preserve more specific provenance for known external/extraction
+    surfaces; otherwise string outputs use TERMINAL_OUTPUT as the generic
+    model-visible tool-output surface. Only a very small set of agent-loop
+    control tools is exempted by render_model_visible_tool_result().
+    """
+    name = (tool_name or "").lower()
+    if name in _TOOL_RESULT_SURFACES:
+        return _TOOL_RESULT_SURFACES[name]
+    for pattern, surface in _TOOL_RESULT_NAME_PATTERNS:
+        if pattern in name:
+            return surface
+    return ContextSurface.TERMINAL_OUTPUT
+
+def _tool_result_nested_label(base_label: str, key: object) -> str:
+    key_text = str(key).strip() or "item"
+    return f"{base_label}.{key_text}" if base_label else key_text
+
+
+_TRUSTED_SKILL_AUTHORITIES = {"trusted", "trusted_by_local_policy"}
+
+
+def _skill_view_result_has_trusted_authority(result: Any) -> bool:
+    """Return True for skill_view results explicitly trusted by local policy."""
+    payload: Any = result
+    if isinstance(result, str):
+        try:
+            payload = json.loads(result)
+        except Exception:
+            return False
+    if not isinstance(payload, Mapping):
+        return False
+    if payload.get("success") is False:
+        return False
+    authority = str(payload.get("authority") or "").strip().lower()
+    return authority in _TRUSTED_SKILL_AUTHORITIES
+
+
+_COMPLETE_UNTRUSTED_CONTEXT_RE = re.compile(
+    r"^\s*<untrusted-context\b(?P<attrs>[^>]*)>(?P<body>[\s\S]*?)</untrusted-context>\s*$",
+    re.IGNORECASE,
+)
+_RENDERED_BY_MARKERS = frozenset({"hermes_context_safety_v1", "hermes_gateway_fallback_v1"})
+
+
+def is_rendered_untrusted_context(text: str) -> bool:
+    """Return True only for internally rendered, structurally safe fences.
+
+    Arbitrary web/tool/plugin output can spoof a complete <untrusted-context>
+    block.  Idempotence must therefore be conservative: skip re-wrapping only
+    when the fence carries the renderer marker and the body contains no raw angle
+    brackets.  Internally rendered bodies are HTML-escaped, so raw '<' or '>' is
+    evidence that the block was spoofed or structurally unsafe and must be
+    escaped by an outer fence.
+    """
+    match = _COMPLETE_UNTRUSTED_CONTEXT_RE.match(text or "")
+    if not match:
+        return False
+    attrs = match.group("attrs") or ""
+    if not any(
+        f'rendered_by="{marker}"' in attrs or f"rendered_by='{marker}'" in attrs
+        for marker in _RENDERED_BY_MARKERS
+    ):
+        return False
+    body = match.group("body") or ""
+    return "<" not in body and ">" not in body
+
+
+def _render_model_visible_tool_string(
+    tool_name: str,
+    result: str,
+    *,
+    source_label: str | None = None,
+) -> str:
+    if is_rendered_untrusted_context(result):
+        return result
+    surface = classify_tool_result_surface(tool_name)
+    safety = scan_and_render_untrusted_context(
+        result,
+        surface=surface,
+        source_label=source_label or tool_name,
+        max_scan_chars=None,
+    )
+    return safety.rendered_text or result
+
+
+def _parse_json_object_or_array_string(value: str) -> Any | None:
+    stripped = value.lstrip()
+    if not stripped or stripped[0] not in "{[":
+        return None
+    try:
+        parsed = json.loads(value)
+    except (TypeError, ValueError):
+        return None
+    if isinstance(parsed, (Mapping, list)):
+        return parsed
+    return None
+
+
+_TRUSTED_TOOL_RESULT_KEYS = {
+    "evidence_ledger",
+    "schema",
+    "ledger_schema",
+    "tool_name",
+    "ledger_type",
+    "trust_boundary",
+    "instruction_authority",
+    "can_inform_response",
+    "can_authorize_action",
+    "side_effect_use_policy",
+    "surface",
+    "source_label",
+    "validation",
+    "read_only",
+    "evidence_items",
+    "id",
+    "source_type",
+    "content",
+    "text",
+    "title",
+    "items",
+    "results",
+    "snapshot",
+    "sections",
+    "ok",
+    "success",
+    "name",
+    "path",
+    "outer",
+    "recipient",
+    "body",
+    "url",
+}
+
+
+def _valid_evidence_item_mapping(value: Any) -> bool:
+    if not isinstance(value, Mapping):
+        return False
+    if not str(value.get("id") or "").strip():
+        return False
+    if str(value.get("instruction_authority") or "").strip().lower() != "none":
+        return False
+    if value.get("can_authorize_action") is not None and value.get("can_authorize_action") is not False:
+        return False
+    return True
+
+
+def _is_native_evidence_ledger_mapping(value: Any) -> bool:
+    if not isinstance(value, Mapping):
+        return False
+    schema = str(value.get("schema") or value.get("ledger_schema") or "")
+    if schema not in {"hermes.tool_result_ledger.v1", "hermes.evidence_ledger.v1"}:
+        return False
+    if not str(value.get("tool_name") or "").strip():
+        return False
+    evidence_items = value.get("evidence_items")
+    if not isinstance(evidence_items, list) or not evidence_items:
+        return False
+    return all(_valid_evidence_item_mapping(item) for item in evidence_items)
+
+
+def _is_legacy_evidence_ledger_mapping(value: Any) -> bool:
+    if not isinstance(value, Mapping):
+        return False
+    if str(value.get("schema") or "") not in {"hermes.tool_result_ledger.legacy.v1", "hermes.evidence_ledger.legacy.v1"}:
+        return False
+    if str(value.get("ledger_type") or "") == "plugin_transform_downgrade":
+        return (
+            value.get("can_authorize_action") is False
+            and str(value.get("instruction_authority") or "").strip().lower() == "none"
+            and str(value.get("validation") or "").startswith("plugin_transform_")
+        )
+    return (
+        value.get("can_authorize_action") is False
+        and str(value.get("instruction_authority") or "").strip().lower() == "none"
+        and str(value.get("validation") or "") == "legacy_wrapped_missing_native_ledger"
+    )
+
+
+def _is_evidence_ledger_mapping(value: Any) -> bool:
+    return _is_native_evidence_ledger_mapping(value) or _is_legacy_evidence_ledger_mapping(value)
+
+
+def _trusted_tool_result_key(key: object) -> bool:
+    return isinstance(key, str) and key in _TRUSTED_TOOL_RESULT_KEYS
+
+
+_INTERNAL_TOOL_RESULT_KEYS = {"action_decisions"}
+_ACTION_DECISION_SCHEMA = "hermes.action_decision.v1"
+
+
+def _compact_internal_control_text(value: Any, *, limit: int = 240) -> str:
+    text = " ".join(str(value or "").split())
+    if len(text) <= limit:
+        return text
+    return text[: limit - 3] + "..."
+
+
+def _without_internal_tool_result_metadata(value: Any) -> Any:
+    """Drop internal dispatch metadata before model-visible promotion."""
+    if isinstance(value, Mapping):
+        rendered: dict[Any, Any] = {}
+        changed = False
+        for key, nested in value.items():
+            if key in _INTERNAL_TOOL_RESULT_KEYS:
+                changed = True
+                continue
+            cleaned = _without_internal_tool_result_metadata(nested)
+            if cleaned is not nested:
+                changed = True
+            rendered[key] = cleaned
+        return rendered if changed else value
+    if isinstance(value, list):
+        rendered = [_without_internal_tool_result_metadata(nested) for nested in value]
+        return rendered if any(cleaned is not nested for cleaned, nested in zip(rendered, value)) else value
+    if isinstance(value, tuple):
+        rendered = tuple(_without_internal_tool_result_metadata(nested) for nested in value)
+        return rendered if any(cleaned is not nested for cleaned, nested in zip(rendered, value)) else value
+    return value
+
+
+def _first_action_decision(value: Any) -> Mapping[str, Any] | None:
+    if not isinstance(value, Mapping):
+        return None
+    decisions = value.get("action_decisions")
+    if isinstance(decisions, list):
+        for decision in decisions:
+            if isinstance(decision, Mapping) and str(decision.get("schema") or "") == _ACTION_DECISION_SCHEMA:
+                return decision
+    return None
+
+
+def _is_action_authority_denial_payload(value: Any) -> bool:
+    if not isinstance(value, Mapping):
+        return False
+    event = value.get("safety_event")
+    if isinstance(event, Mapping) and str(event.get("type") or "") == "action_authority_denial":
+        return True
+    error = str(value.get("error") or "")
+    if error.startswith("Safety block: action authority denied"):
+        return True
+    return _first_action_decision(value) is not None and str(value.get("decision") or "") in {"block", "require_confirmation"}
+
+
+def _action_authority_denial_notice(value: Mapping[str, Any]) -> str:
+    decision_payload = _first_action_decision(value) or {}
+    decision = str(value.get("decision") or decision_payload.get("decision") or "denied")
+    action_class = str(value.get("action_class") or decision_payload.get("action_class") or "action")
+    source = str(value.get("authority_source") or decision_payload.get("authority_source") or "").strip()
+    reason = _compact_internal_control_text(value.get("reason") or decision_payload.get("reason") or "action authority denied")
+    retry = value.get("retry_possible_with_exact_trusted_scope")
+    if retry is None:
+        retry = bool(decision_payload.get("safety_block"))
+    parts = [f"Safety block: action authority {decision} for {action_class}."]
+    if source:
+        parts.append(f"Authority source: {source}.")
+    if reason:
+        parts.append(f"Reason: {reason}.")
+    if retry:
+        parts.append("Retry only after the user provides exact trusted scope.")
+    return " ".join(parts)
+
+
+def _value_contains_native_evidence_ledger(value: Any) -> bool:
+    if isinstance(value, Mapping):
+        ledger = value.get("evidence_ledger")
+        return _is_native_evidence_ledger_mapping(ledger)
+    if isinstance(value, (list, tuple)):
+        if not value:
+            return False
+        for nested in value:
+            if isinstance(nested, Mapping):
+                if not _is_native_evidence_ledger_mapping(nested.get("evidence_ledger")):
+                    return False
+            elif isinstance(nested, (list, tuple)):
+                if not _value_contains_native_evidence_ledger(nested):
+                    return False
+            else:
+                return False
+        return True
+    return False
+
+
+def _value_contains_plugin_transform_downgrade(value: Any) -> bool:
+    def _is_plugin_transform_ledger(ledger: Any) -> bool:
+        return _is_legacy_evidence_ledger_mapping(ledger) and str(ledger.get("ledger_type") or "") == "plugin_transform_downgrade"
+    if isinstance(value, Mapping):
+        return _is_plugin_transform_ledger(value.get("evidence_ledger"))
+    if isinstance(value, (list, tuple)):
+        return any(isinstance(nested, Mapping) and _is_plugin_transform_ledger(nested.get("evidence_ledger")) for nested in value)
+    return False
+
+
+def _tool_result_requires_native_evidence_ledger(tool_name: str) -> bool:
+    name = (tool_name or "").lower()
+    if name in trusted_internal_tool_result_names():
+        return False
+    return classify_tool_result_surface(name) in {
+        ContextSurface.DOWNLOADED_TEXT,
+        ContextSurface.EXTRACTION_OUTPUT,
+        ContextSurface.GATEWAY_ATTACHMENT_TEXT,
+        ContextSurface.GATEWAY_STT_TRANSCRIPT,
+        ContextSurface.GATEWAY_OCR_TEXT,
+        ContextSurface.GATEWAY_DOCUMENT_TEXT,
+        ContextSurface.SKILL_CONTENT,
+    }
+
+
+def _evidence_ledger_validation_mode_enabled() -> bool:
+    return (os.environ.get("HERMES_REQUIRE_EVIDENCE_LEDGER") or "").strip().lower() in {"1", "true", "yes", "strict"}
+
+
+def _legacy_evidence_ledger(tool_name: str, source_label: str | None) -> dict[str, Any]:
+    surface = classify_tool_result_surface(tool_name)
+    return {
+        "schema": "hermes.tool_result_ledger.legacy.v1",
+        "tool_name": tool_name,
+        "ledger_type": "legacy_model_visible_wrapper",
+        "trust_boundary": "untrusted_external",
+        "instruction_authority": "none",
+        "can_inform_response": True,
+        "can_authorize_action": False,
+        "side_effect_use_policy": "not_authority_for_side_effects",
+        "surface": surface.value,
+        "source_label": source_label or tool_name,
+        "validation": "legacy_wrapped_missing_native_ledger",
+    }
+
+
+def _plugin_transform_downgrade_ledger(
+    tool_name: str,
+    source_label: str | None,
+    reason: str,
+) -> dict[str, Any]:
+    ledger = _legacy_evidence_ledger(tool_name, source_label or "plugin_tool_result_transform")
+    ledger["ledger_type"] = "plugin_transform_downgrade"
+    ledger["validation"] = reason
+    ledger["trust_boundary"] = "trusted_plugin_code_untrusted_output"
+    return ledger
+
+
+def _extract_evidence_ledger(value: Any) -> Any:
+    if isinstance(value, str):
+        parsed = _parse_json_object_or_array_string(value)
+        if parsed is not None:
+            value = parsed
+    if isinstance(value, Mapping):
+        return value.get("evidence_ledger")
+    return None
+
+
+def sanitize_plugin_transformed_tool_result(
+    tool_name: str,
+    original_result: Any,
+    transformed_result: Any,
+    *,
+    source_label: str | None = "plugin_tool_result_transform",
+) -> Any:
+    """Constrain plugin result transforms before model-visible promotion.
+
+    Plugin code is a trusted-code boundary, but plugin-produced text is not
+    trusted user intent. A transform hook may redact or summarize output, yet
+    it cannot mint native ledgers or remove a native evidence ledger while
+    keeping native trust metadata. Such cases are downgraded to an explicit
+    plugin-transform ledger before normal rendering fences nested strings.
+    """
+    original_ledger = _extract_evidence_ledger(original_result)
+    transformed_ledger = _extract_evidence_ledger(transformed_result)
+    original_has_native = _is_native_evidence_ledger_mapping(original_ledger)
+    transformed_has_native = _is_native_evidence_ledger_mapping(transformed_ledger)
+    ledger_removed = original_has_native and not transformed_has_native
+    ledger_forged = not original_has_native and transformed_has_native
+    ledger_replaced = original_has_native and transformed_has_native and transformed_ledger != original_ledger
+    if not (ledger_removed or ledger_forged or ledger_replaced):
+        return transformed_result
+
+    if ledger_removed:
+        reason = "plugin_transform_removed_native_evidence_ledger"
+    elif ledger_forged:
+        reason = "plugin_transform_forged_native_evidence_ledger"
+    else:
+        reason = "plugin_transform_replaced_native_evidence_ledger"
+    downgrade = _plugin_transform_downgrade_ledger(tool_name, source_label, reason)
+
+    if isinstance(transformed_result, str):
+        parsed = _parse_json_object_or_array_string(transformed_result)
+        if isinstance(parsed, Mapping):
+            rendered = dict(parsed)
+            rendered["evidence_ledger"] = downgrade
+            return rendered
+        return {"content": transformed_result, "evidence_ledger": downgrade}
+    if isinstance(transformed_result, Mapping):
+        rendered = dict(transformed_result)
+        rendered["evidence_ledger"] = downgrade
+        return rendered
+    return {"content": transformed_result, "evidence_ledger": downgrade}
+
+
+def _render_model_visible_tool_value(
+    tool_name: str,
+    value: Any,
+    *,
+    source_label: str | None = None,
+) -> Any:
+    if isinstance(value, str):
+        return _render_model_visible_tool_string(tool_name, value, source_label=source_label)
+    if isinstance(value, Mapping):
+        base = source_label or tool_name
+        rendered: dict[Any, Any] = {}
+        for index, (key, nested) in enumerate(value.items()):
+            if key == "evidence_ledger" and _is_evidence_ledger_mapping(nested):
+                rendered[key] = nested
+            elif _trusted_tool_result_key(key):
+                rendered[key] = _render_model_visible_tool_value(
+                    tool_name,
+                    nested,
+                    source_label=_tool_result_nested_label(base, key),
+                )
+            else:
+                neutral_key = f"untrusted_key_{index}"
+                key_label = _tool_result_nested_label(base, neutral_key)
+                rendered[neutral_key] = {
+                    "key": _render_model_visible_tool_string(tool_name, str(key), source_label=f"{key_label}.key"),
+                    "value": _render_model_visible_tool_value(
+                        tool_name,
+                        nested,
+                        source_label=f"{key_label}.value",
+                    ),
+                }
+        return rendered
+    if isinstance(value, list):
+        base = source_label or tool_name
+        return [
+            _render_model_visible_tool_value(
+                tool_name,
+                nested,
+                source_label=_tool_result_nested_label(base, idx),
+            )
+            for idx, nested in enumerate(value)
+        ]
+    if isinstance(value, tuple):
+        base = source_label or tool_name
+        return tuple(
+            _render_model_visible_tool_value(
+                tool_name,
+                nested,
+                source_label=_tool_result_nested_label(base, idx),
+            )
+            for idx, nested in enumerate(value)
+        )
+    return value
+
+
+def render_model_visible_tool_result(
+    tool_name: str,
+    result: Any,
+    *,
+    source_label: str | None = None,
+) -> Any:
+    """Fence model-visible tool results before appending tool messages.
+
+    String output from tools is evidence by default, including strings nested
+    inside JSON-like dict/list results. The only preserved raw results are
+    explicit trusted internal agent-loop control tools whose output is not
+    external content. Callers that need a trusted result shape must add an
+    explicit exemption and test justification.
+    """
+    name = (tool_name or "").lower()
+    if name in trusted_internal_tool_result_names():
+        return result
+    if name == "skill_view" and _skill_view_result_has_trusted_authority(result):
+        return result
+    label = source_label or tool_name
+    promotion_result = result
+    if isinstance(result, str):
+        parsed_result = _parse_json_object_or_array_string(result)
+        if parsed_result is not None:
+            promotion_result = parsed_result
+    if _is_action_authority_denial_payload(promotion_result):
+        return _action_authority_denial_notice(promotion_result)
+    promotion_result = _without_internal_tool_result_metadata(promotion_result)
+    structured_result = isinstance(promotion_result, (Mapping, list, tuple))
+    if (
+        structured_result
+        and _tool_result_requires_native_evidence_ledger(tool_name)
+        and not _value_contains_native_evidence_ledger(promotion_result)
+        and not _value_contains_plugin_transform_downgrade(promotion_result)
+    ):
+        if _evidence_ledger_validation_mode_enabled():
+            raise ValueError(f"Tool result for {tool_name!r} is missing native evidence_ledger")
+        if isinstance(promotion_result, Mapping):
+            rendered = _render_model_visible_tool_value(tool_name, promotion_result, source_label=label)
+            rendered["evidence_ledger"] = _legacy_evidence_ledger(tool_name, label)
+            return rendered
+    return _render_model_visible_tool_value(tool_name, promotion_result, source_label=label)
