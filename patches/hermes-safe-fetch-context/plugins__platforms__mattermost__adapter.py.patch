+def _is_policy_block_safe_http_error(exc: SafeHTTPError) -> bool:
+    message = str(exc)
+    return (
+        message.startswith("Blocked unsafe URL")
+        or message.startswith("Blocked disallowed content type")
+        or message.startswith("Blocked credential-bearing cross-origin redirect")
+        or message.startswith("Blocked content whose bytes do not match")
+        or message.startswith("Response too large")
+    )
+
+
+def _is_non_retryable_safe_http_error(exc: SafeHTTPError) -> bool:
+    message = str(exc)
+    return "HTTP status 4" in message and "HTTP status 429" not in message
 
 
