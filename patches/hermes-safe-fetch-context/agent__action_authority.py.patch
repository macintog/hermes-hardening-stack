+_DEV_AUTHORITY_ALLOW_COMMIT_ENV = "HERMES_DEV_AUTHORITY_ALLOW_COMMIT"
+_DEV_AUTHORITY_ALLOW_NETWORK_ENV = "HERMES_DEV_AUTHORITY_ALLOW_NETWORK"
+_DEV_AUTHORITY_ALLOW_SUDO_ENV = "HERMES_DEV_AUTHORITY_ALLOW_SUDO"
