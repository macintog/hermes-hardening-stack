+def _path_under_root(value: str, root: Path, *, cwd: Path | None = None) -> bool:
+    try:
+        candidate = Path(value).expanduser()
+        if not candidate.is_absolute():
+            candidate = (cwd or root) / candidate
+        candidate = candidate.resolve(strict=False)
+        candidate.relative_to(root)
+        return True
+    except Exception:
+        return False
+
+
+def _path_under_prefix(value: str, prefixes: tuple[str, ...], *, cwd: Path | None = None) -> bool:
+    try:
+        candidate = Path(value).expanduser()
+        if not candidate.is_absolute():
+            candidate = (cwd or Path.cwd()) / candidate
+        candidate = candidate.resolve(strict=False)
+    except Exception:
+        return False
+    for prefix in prefixes:
+        try:
+            prefix_path = Path(prefix).expanduser().resolve(strict=False)
+            parent = prefix_path.parent.resolve(strict=True)
+            rel = candidate.relative_to(parent)
+        except Exception:
+            continue
+        if not rel.parts:
+            continue
+        scoped_root = parent / rel.parts[0]
+        if (
+            rel.parts[0].startswith(prefix_path.name)
+            and len(rel.parts[0]) > len(prefix_path.name)
+            and scoped_root.exists()
+            and scoped_root.is_dir()
+        ):
+            return True
+    return False
+
+
+def _path_allowed_by_dev_authority(value: str, authority: DevelopmentAuthority, *, cwd: Path | None = None) -> bool:
+    return _path_under_root(value, authority.root, cwd=cwd) or _path_under_prefix(value, authority.tmp_prefixes, cwd=cwd)
+
+
+def _looks_pathish(token: str) -> bool:
+    if token.startswith(("/", "./", "../", "~")):
+        return True
+    return "/" in token and not re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", token)
+
+
+def _looks_like_concrete_local_path(token: str) -> bool:
+    token = token.strip(".,;:()[]{}\"'")
+    if token.startswith(("/", "./", "../", "~")):
+        return True
+    if not _looks_pathish(token):
+        return False
+    return bool(re.search(r"(?:^|/)[^/\s]+\.[A-Za-z0-9]{1,12}(?:$|/)", token))
+
+
+def _command_words(command: str) -> list[str]:
+    try:
+        return shlex.split(command, posix=True)
+    except ValueError:
+        return []
+
+
+def _interpreter_snippet_denial(command: str, *, allow_network: bool = False) -> str | None:
+    words = _command_words(command)
+    if not words:
+        return None
+    program = os.path.basename(words[0]).lower()
+    if program not in _INTERPRETER_COMMANDS:
+        return None
+    snippet_markers = {"-c", "-e", "<<", "<<-"}
+    has_inline_snippet = "\n" in command or any(token in words for token in snippet_markers) or any("<<" in token for token in words)
+    if not has_inline_snippet:
+        return None
+    if not allow_network and re.search(r"(?i)\b(import|from|require)\s+(socket|requests|urllib|http\.client|ftplib|smtplib|paramiko|websocket)\b", command):
+        return "local authority denied interpreter snippet with network imports"
+    if re.search(r"(?i)\b(os\.environ|process\.env|environ\b|getenv\s*\()", command):
+        return "local authority denied interpreter snippet that reads environment"
+    if _SECRET_LIKE_RE.search(command) or _SECRET_PATH_RE.search(command) or re.search(r"(?i)(?:\.ssh/|id_rsa|id_ed25519|\.env\b)", command):
+        return "local authority denied interpreter snippet that reads secret-like material"
+    return None
+
+
+def _shell_punctuation_tokens(command: str) -> list[str]:
+    try:
+        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
+        lexer.whitespace_split = True
+        return list(lexer)
+    except ValueError:
+        return []
+
+
+def _has_shell_control_operator(command: str) -> bool:
+    tokens = _shell_punctuation_tokens(command)
+    if not tokens:
+        return False
+    return any(token in _SHELL_CONTROL_TOKENS for token in tokens)
+
+
+_ABSENCE_ECHO_TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,80}_absent$")
+
+
+def _safe_absence_path_variants(path: str) -> list[str]:
+    raw = (path or "").strip()
+    if not raw or "\x00" in raw:
+        return []
+    if any(marker in raw for marker in ("`", "$(", "<(", ">(", "|", ";", "&", ">", "<", "\n", "\r")):
+        return []
+    if re.search(r"[*?\[\]]", raw):
+        return []
+    expanded = raw
+    if raw == "$HOME" or raw.startswith("$HOME/"):
+        expanded = str(Path.home()) + raw[len("$HOME") :]
+    elif raw == "${HOME}" or raw.startswith("${HOME}/"):
+        expanded = str(Path.home()) + raw[len("${HOME}") :]
+    elif "$" in raw:
+        return []
+    if "$" in expanded or _secretish_path(raw) or _secretish_path(expanded):
+        return []
+    variants = [raw]
+    if expanded != raw:
+        variants.append(expanded)
+    if expanded.startswith(str(Path.home()) + "/"):
+        variants.append("~" + expanded[len(str(Path.home())) :])
+    return list(dict.fromkeys(variants))
+
+
+def _read_only_absence_check_parts(command: str) -> tuple[str, str] | None:
+    if any(marker in command for marker in ("`", "$(", "<(", ">(")):
+        return None
+    tokens = _shell_punctuation_tokens(command)
+    if not tokens or tokens.count("&&") != 1:
+        return None
+    if any(token in {"|", "||", "&", ";", "<", "<<", "<<<", ">", ">>", "2>", "2>>"} for token in tokens):
+        return None
+    split_at = tokens.index("&&")
+    left = tokens[:split_at]
+    right = tokens[split_at + 1 :]
+    path = ""
+    if len(left) == 4 and left[:3] == ["test", "!", "-e"]:
+        path = left[3]
+    elif len(left) == 5 and left[:3] == ["[", "!", "-e"] and left[4] == "]":
+        path = left[3]
+    else:
+        return None
+    if len(right) != 2 or right[0] != "echo" or not _ABSENCE_ECHO_TOKEN_RE.fullmatch(right[1]):
+        return None
+    if not _safe_absence_path_variants(path):
+        return None
+    return path, right[1]
+
+
+def _network_fetch_piped_to_interpreter(command: str) -> bool:
+    tokens = _shell_punctuation_tokens(command)
+    if "|" not in tokens:
+        return False
+    pipe_indexes = [index for index, token in enumerate(tokens) if token == "|"]
+    for index, token in enumerate(tokens[:-2]):
+        if os.path.basename(token).lower() not in {"curl", "wget"}:
+            continue
+        try:
+            first_pipe_index = tokens.index("|", index + 1)
+        except ValueError:
+            continue
+        for pipe_index in pipe_indexes:
+            if pipe_index < first_pipe_index or pipe_index + 1 >= len(tokens):
+                continue
+            if os.path.basename(tokens[pipe_index + 1]).lower() in _PIPE_INTERPRETER_COMMANDS:
+                return True
+    return False
+
+
+def _read_only_pipe_relay_segment(words: list[str], trusted_scope_text: str) -> bool:
+    if not words:
+        return False
+    program = os.path.basename(words[0]).lower()
+    args = words[1:]
+    if program == "cat":
+        return all(
+            arg.startswith("-")
+            or (
+                _looks_pathish(arg)
+                and not _secretish_path(arg)
+                and _value_in_text(arg, trusted_scope_text or "")
+            )
+            for arg in args
+        )
+    if program in {"less", "more"}:
+        return all(arg.startswith("-") for arg in args)
+    if program == "sed":
+        if not args:
+            return False
+        for arg in args:
+            low = arg.lower()
+            if low in {"-i", "--in-place"} or low.startswith(("-i", "--in-place=")):
+                return False
+            if low in {"-e", "-r", "-n", "-u", "-s"}:
+                continue
+            if low.startswith("-") and not set(low[1:]).issubset({"e", "n", "r", "u", "s", "E"}):
+                return False
+        return not any(re.search(r"(^|[^\\])w\\s+", arg) for arg in args)
+    return False
+
+
+def _network_fetch_pipe_has_read_only_fetch(command: str, trusted_scope_text: str) -> bool:
+    tokens = _shell_punctuation_tokens(command)
+    for index, token in enumerate(tokens[:-2]):
+        program = os.path.basename(token).lower()
+        if program not in {"curl", "wget"}:
+            continue
+        interpreter_pipe_indexes = [
+            pipe_index
+            for pipe_index, pipe_token in enumerate(tokens[index + 1 :], start=index + 1)
+            if pipe_token == "|"
+            and pipe_index + 1 < len(tokens)
+            and os.path.basename(tokens[pipe_index + 1]).lower()
+            in _PIPE_INTERPRETER_COMMANDS
+        ]
+        if not interpreter_pipe_indexes:
+            continue
+        interpreter_pipe_index = interpreter_pipe_indexes[-1]
+        fetch_end = next(
+            (
+                control_index
+                for control_index, control_token in enumerate(tokens[index + 1 : interpreter_pipe_index], start=index + 1)
+                if control_token in _SHELL_CONTROL_TOKENS
+            ),
+            interpreter_pipe_index,
+        )
+        words = tokens[index:fetch_end]
+        if program == "curl":
+            parts = _curl_read_only_fetch_parts(words)
+        else:
+            parts = _wget_read_only_fetch_parts(words)
+        if parts is None:
+            return False
+        urls, output_paths = parts
+        if fetch_end < len(tokens) and tokens[fetch_end] == "|" and any(path != "-" for path in output_paths):
+            return False
+        if any(path != "-" and (_secretish_path(path) or not _value_in_text(path, trusted_scope_text or "")) for path in output_paths):
+            return False
+        if not urls or not all(_value_in_text(url, trusted_scope_text or "") for url in urls):
+            return False
+        relay_start = fetch_end + 1
+        while relay_start < interpreter_pipe_index:
+            relay_end = next(
+                (
+                    control_index
+                    for control_index, control_token in enumerate(tokens[relay_start:interpreter_pipe_index], start=relay_start)
+                    if control_token in _SHELL_CONTROL_TOKENS
+                ),
+                interpreter_pipe_index,
+            )
+            if not _read_only_pipe_relay_segment(tokens[relay_start:relay_end], trusted_scope_text):
+                return False
+            relay_start = relay_end + 1
+        return True
+    return False
+
+
+def _trusted_scopes_read_only_fetch_url(url: str, trusted_text: str) -> bool:
+    if not _value_in_text(url, trusted_text or ""):
+        return False
+    clauses = [
+        part.strip()
+        for part in re.split(r"(?:[\n\r!?;]+|\.(?:\s+|$)|\s+\bbut\b\s+|\s+\bhowever\b\s+)", trusted_text or "", flags=re.IGNORECASE)
+        if part.strip()
+    ]
+    for clause in clauses:
+        if not _value_in_text(url, clause):
+            continue
+        if _NEGATED_AUTHORITY_RE.search(clause) or _DOCUMENTARY_AUTHORITY_RE.search(clause):
+            continue
+        if _READ_ONLY_FETCH_VERB_RE.search(clause):
+            return True
+    return False
+
+
+def _trusted_scopes_fetch_output_path(path: str, trusted_text: str) -> bool:
+    if path == "-":
+        return True
+    if _secretish_path(path):
+        return False
+    return _affirmative_value_in_text(path, trusted_text or "", ActionClass.FILE_WRITE)
+
+
+def _curl_read_only_fetch_parts(words: list[str]) -> tuple[list[str], list[str]] | None:
+    urls: list[str] = []
+    output_paths: list[str] = []
+    index = 1
+    while index < len(words):
+        token = words[index]
+        low = token.lower()
+        if _READ_ONLY_FETCH_URL_RE.match(token):
+            urls.append(token)
+            index += 1
+            continue
+        if low in {"-o", "--output"}:
+            index += 1
+            if index >= len(words):
+                return None
+            output_paths.append(words[index])
+            index += 1
+            continue
+        if low.startswith("--output="):
+            output_paths.append(token.split("=", 1)[1])
+            index += 1
+            continue
+        if low.startswith("-o") and len(token) > 2:
+            output_paths.append(token[2:])
+            index += 1
+            continue
+        if any(low == prefix or low.startswith(prefix + "=") for prefix in _CURL_UNSAFE_LONG_PREFIXES):
+            return None
+        if low in _CURL_SAFE_LONG_FLAGS:
+            index += 1
+            continue
+        if low in _CURL_SAFE_LONG_WITH_VALUE:
+            index += 2
+            if index > len(words):
+                return None
+            continue
+        if any(low.startswith(option + "=") for option in _CURL_SAFE_LONG_WITH_VALUE):
+            index += 1
+            continue
+        if low.startswith("--"):
+            return None
+        if low.startswith("-"):
+            flags = token[1:]
+            if not flags or any(flag in _CURL_UNSAFE_SHORT_OPTIONS for flag in flags):
+                return None
+            if all(flag in _CURL_SAFE_FLAGS for flag in flags):
+                index += 1
+                continue
+            return None
+        return None
+    return (urls, output_paths) if urls else None
+
+
+def _wget_read_only_fetch_parts(words: list[str]) -> tuple[list[str], list[str]] | None:
+    urls: list[str] = []
+    output_paths: list[str] = []
+    index = 1
+    while index < len(words):
+        token = words[index]
+        low = token.lower()
+        if _READ_ONLY_FETCH_URL_RE.match(token):
+            urls.append(token)
+            index += 1
+            continue
+        if low in {"-o", "--output-document"}:
+            index += 1
+            if index >= len(words):
+                return None
+            output_paths.append(words[index])
+            index += 1
+            continue
+        if low.startswith("--output-document="):
+            output_paths.append(token.split("=", 1)[1])
+            index += 1
+            continue
+        if low.startswith("-o") and len(token) > 2:
+            output_paths.append(token[2:])
+            index += 1
+            continue
+        if any(low == prefix or low.startswith(prefix + "=") for prefix in _WGET_UNSAFE_LONG_PREFIXES):
+            return None
+        if low in _WGET_SAFE_LONG_FLAGS:
+            index += 1
+            continue
+        if low.startswith("--"):
+            return None
+        if low.startswith("-"):
+            flags = token[1:]
+            if not flags:
+                return None
+            if "O" in flags:
+                option_index = flags.index("O")
+                if not all(flag in (_WGET_SAFE_FLAGS - {"O"}) for flag in flags[:option_index]):
+                    return None
+                output_path = flags[option_index + 1 :]
+                if not output_path:
+                    index += 1
+                    if index >= len(words):
+                        return None
+                    output_path = words[index]
+                output_paths.append(output_path)
+                index += 1
+                continue
+            if not all(flag in (_WGET_SAFE_FLAGS - {"O"}) for flag in flags):
+                return None
+            index += 1
+            continue
+        return None
+    return (urls, output_paths) if urls else None
+
+
+def _trusted_read_only_terminal_fetch(
+    command: str,
+    trusted_scope_text: str,
+) -> bool:
+    words = _command_words(command)
+    if not words or _has_shell_control_operator(command):
+        return False
+    program = os.path.basename(words[0]).lower()
+    if program == "curl":
+        parts = _curl_read_only_fetch_parts(words)
+    elif program == "wget":
+        parts = _wget_read_only_fetch_parts(words)
+    else:
+        return False
+    if parts is None:
+        return False
+    urls, output_paths = parts
+    if not urls or not all(_trusted_scopes_read_only_fetch_url(url, trusted_scope_text) for url in urls):
+        return False
+    if not all(_trusted_scopes_fetch_output_path(path, trusted_scope_text) for path in output_paths):
+        return False
+    return True
+
+
+def _unsafe_shell_expansion(command: str) -> bool:
+    if any(marker in command for marker in ("`", "$(", "<(", ">(")):
+        return True
+    for match in re.finditer(r"\$(?:\{([A-Za-z_][A-Za-z0-9_]*)\}|([A-Za-z_][A-Za-z0-9_]*))", command):
+        if (match.group(1) or match.group(2)) != "HOME":
+            return True
+    return False
+
+
+def _command_denied_by_dev_authority(command: str, authority: DevelopmentAuthority, cwd: Path) -> str | None:
+    return _command_denied_by_local_policy(
+        command,
+        cwd,
+        root=authority.root,
+        tmp_prefixes=authority.tmp_prefixes,
+        allow_commit=authority.allow_commit,
+        allow_network=authority.allow_network,
+        allow_sudo=authority.allow_sudo,
+    )
+
+
+def _command_denied_by_local_policy(
+    command: str,
+    cwd: Path,
+    *,
+    root: Path | None = None,
+    tmp_prefixes: tuple[str, ...] = (),
+    trusted_scope_text: str = "",
+    allow_commit: bool = False,
+    allow_network: bool = False,
+    allow_sudo: bool = False,
+) -> str | None:
+    lowered = command.lower()
+    if _DESTRUCTIVE_COMMAND_RE.search(command):
+        return "local authority denied destructive git/filesystem command"
+    if _GIT_EXTERNAL_DIFF_RE.search(command):
+        return "local authority denied git external diff execution"
+    words = _command_words(command)
+    if command and not words:
+        return "local authority could not parse terminal command safely"
+    if _unsafe_shell_expansion(command):
+        return "local authority denied shell substitution or unsafe parameter expansion"
+    tokens = _shell_punctuation_tokens(command)
+    for index, token in enumerate(tokens[:-1]):
+        if token == "|" and os.path.basename(tokens[index + 1]).lower() in _PIPE_INTERPRETER_COMMANDS:
+            return "local authority denied pipe to interpreter"
+    snippet_denial = _interpreter_snippet_denial(command, allow_network=allow_network)
+    if snippet_denial:
+        return snippet_denial
+    trusted_read_only_fetch = (
+        not allow_network and _trusted_read_only_terminal_fetch(command, trusted_scope_text)
+    )
+    for index, token in enumerate(words):
+        low = token.lower()
+        base = os.path.basename(low)
+        previous = words[index - 1].lower() if index else ""
+        if base in {"sudo", "su", "doas"} and not allow_sudo:
+            return "local authority denied sudo/su command"
+        if base in _NETWORK_COMMANDS and not allow_network and not trusted_read_only_fetch:
+            return "local authority denied network command"
+        if base in _SECRET_DUMP_COMMANDS:
+            return "local authority denied environment/secret dump command"
+        if low == "commit" and previous == "git" and not allow_commit:
+            return "local authority denied git commit by default"
+        if low == "push" and previous == "git":
+            return "local authority denied git push"
+        if low == "tag" and previous == "git":
+            return "local authority denied git tag"
+        if _secretish_path(token):
+            return "local authority denied secret-like path"
+        if root is not None and _looks_pathish(token) and not token.startswith("-"):
+            trusted_path_scope = bool(trusted_scope_text and _value_in_text(token, trusted_scope_text))
+            if not (_path_under_root(token, root, cwd=cwd) or _path_under_prefix(token, tmp_prefixes, cwd=cwd) or trusted_path_scope):
+                return "local authority denied path outside configured repo root or approved temp prefixes"
+    if ("http://" in lowered or "https://" in lowered) and not allow_network and not trusted_read_only_fetch:
+        return "local authority denied network URL in command"
+    if re.search(r"(?i)\b(chmod|chown)\b[^\n;|&]*(/(?:etc|var|system|users|private|library)|~)", command):
+        return "local authority denied chmod/chown of sensitive location"
+    return None
+
+
+def _terminal_command_denial_for_exact_scope(
+    name: str,
+    action_class: ActionClass,
+    args: Mapping[str, Any] | None,
+    trusted_scope_text: str = "",
+) -> str | None:
+    if not (name in {"terminal", "execute_code", "process"} or action_class == ActionClass.TERMINAL_EXECUTION):
+        return None
+    args = args or {}
+    command = str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+    cwd_raw = str(args.get("workdir") or args.get("cwd") or os.getcwd())
+    cwd = Path(cwd_raw).expanduser()
+    if not cwd.is_absolute():
+        cwd = Path.cwd() / cwd
+    try:
+        cwd = cwd.resolve(strict=False)
+    except Exception:
+        return "local authority could not resolve working directory"
+    return _command_denied_by_local_policy(command, cwd, root=cwd, trusted_scope_text=trusted_scope_text)
+
+
+def _terminal_denial_should_defer_to_terminal_guard(denial: str, args: Mapping[str, Any] | None, trusted_scope_text: str) -> bool:
+    if denial not in {
+        "local authority denied network command",
+        "local authority denied network URL in command",
+        "local authority denied pipe to interpreter",
+    }:
+        return False
+    command = str((args or {}).get("command") or (args or {}).get("code") or (args or {}).get("script") or (args or {}).get("data") or "")
+    if not command or not _value_in_text(command, trusted_scope_text or ""):
+        return False
+    return _network_fetch_piped_to_interpreter(command) and _network_fetch_pipe_has_read_only_fetch(command, trusted_scope_text)
+
+
+def _dev_terminal_parameterized_by_untrusted(command: str, trusted_text: str, combined_untrusted: list[tuple[str | None, str]]) -> bool:
+    if not command or not combined_untrusted:
+        return False
+    untrusted_text = "\n".join(body for _, body in combined_untrusted)
+    for token in _command_words(command):
+        if token.startswith("-") or "=" in token:
+            continue
+        if not (_looks_pathish(token) or "://" in token):
+            continue
+        if _value_in_text(token, untrusted_text) and not _value_in_text(token, trusted_text or ""):
+            return True
+    return False
+
+
+def _external_untrusted_blocks(combined_untrusted: list[tuple[str | None, str]]) -> list[tuple[str | None, str]]:
+    return [
+        (src, body)
+        for src, body in combined_untrusted
+        if (src or "untrusted_context") not in _LOCAL_INSPECTION_EVIDENCE_SOURCES
+    ]
+
+
+def _terminal_command_from_external_untrusted(command: str, trusted_text: str, combined_untrusted: list[tuple[str | None, str]]) -> bool:
+    if not command:
+        return False
+    external = _external_untrusted_blocks(combined_untrusted)
+    if not external:
+        return False
+    untrusted_text = "\n".join(body for _, body in external)
+    normalized_command = _normalize_authority_text(command)
+    if normalized_command and len(normalized_command) >= 4 and normalized_command in _haystack_variants(untrusted_text):
+        return not _value_in_text(command, trusted_text or "")
+    words = _command_words(command)
+    if not words:
+        return False
+    program = os.path.basename(words[0])
+    if len(program) >= 3 and _value_in_text(program, untrusted_text) and not _value_in_text(program, trusted_text or ""):
+        return True
+    for token in words[1:]:
+        if token.startswith("-") or "=" in token:
+            continue
+        if len(token) < 4:
+            continue
+        if _value_in_text(token, untrusted_text) and not _value_in_text(token, trusted_text or ""):
+            return True
+    return False
+
+
+def _development_repo_override_decision(
+    name: str,
+    action_class: ActionClass,
+    args: Mapping[str, Any] | None,
+    trusted_text: str,
+    combined_untrusted: list[tuple[str | None, str]],
+) -> ActionAuthorityResult | None:
+    """Allow local hardening development work inside an explicitly configured repo.
+
+    This is an opt-in development escape hatch, not production policy. It is
+    disabled unless HERMES_DEV_AUTHORITY=1 and HERMES_DEV_AUTHORITY_ROOT points
+    at an absolute existing directory marked as the payload repo, or under an
+    absolute existing HERMES_DEV_AUTHORITY_SAFE_ROOT. It allows terminal/file/test
+    work only when every supplied local path is inside the configured repository
+    root or an approved temporary verifier prefix, and refuses dangerous,
+    network, secret-dumping, publish, and destructive commands unless explicitly
+    enabled by env policy.
+    """
+    authority = DevelopmentAuthority.from_env()
+    if authority is None:
+        return None
+    args = args or {}
+    cwd_raw = str(args.get("workdir") or args.get("cwd") or authority.root)
+    cwd = Path(cwd_raw).expanduser()
+    if not cwd.is_absolute():
+        cwd = authority.root / cwd
+    try:
+        cwd = cwd.resolve(strict=False)
+    except Exception:
+        return authority.result(AuthorityDecision.BLOCK, action_class, "development authority could not resolve working directory")
+    if not _path_allowed_by_dev_authority(str(cwd), authority):
+        return authority.result(AuthorityDecision.BLOCK, action_class, "development authority denied work outside configured repo root or approved temp prefixes")
+    if name in {"terminal", "execute_code", "process"} or action_class == ActionClass.TERMINAL_EXECUTION:
+        command = str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+        denial = _command_denied_by_dev_authority(command, authority, cwd)
+        if denial:
+            return authority.result(AuthorityDecision.BLOCK, action_class, denial)
+        if _dev_terminal_parameterized_by_untrusted(command, trusted_text, _external_untrusted_blocks(combined_untrusted)):
+            return authority.result(AuthorityDecision.BLOCK, action_class, "development authority denied terminal target parameterized by evidence-only untrusted context")
+        return authority.result(AuthorityDecision.ALLOW, action_class)
+
+    if action_class in {ActionClass.SECRET_READ, ActionClass.SECRET_TRANSMISSION}:
+        return authority.result(AuthorityDecision.BLOCK, action_class, "development authority denied secret read/transmission")
+
+    if combined_untrusted and _untrusted_parameterized_targets(name, action_class, args, trusted_text, combined_untrusted):
+        return authority.result(AuthorityDecision.BLOCK, action_class, "development authority denied action parameterized by evidence-only untrusted context")
+
+    if action_class in {ActionClass.FILE_WRITE, ActionClass.FILE_DELETE, ActionClass.READ_ONLY_LOCAL_INSPECTION}:
+        for value in _authority_target_strings(name, action_class, args) or _flatten_arg_strings(args):
+            if _secretish_path(value):
+                return authority.result(AuthorityDecision.BLOCK, action_class, "development authority denied secret-like file target")
+            if _looks_pathish(value) and not _path_allowed_by_dev_authority(value, authority, cwd=cwd):
+                return authority.result(AuthorityDecision.BLOCK, action_class, "development authority denied file target outside configured repo root or approved temp prefixes")
+        return authority.result(AuthorityDecision.ALLOW, action_class)
+
+    return None
+
+
+def _trusted_task_supports_local_work(trusted_user_text: str, trusted_policy_text: str) -> bool:
+    def local_task_clauses(text: str) -> list[str]:
+        return [
+            part.strip()
+            for part in re.split(r"(?:[\n\r!?;]+|\.(?:\s+|$)|\s+\bbut\b\s+|\s+\bhowever\b\s+)", text or "", flags=re.IGNORECASE)
+            if part.strip()
+        ]
+
+    def has_affirmative_local_authority_clause(text: str) -> bool:
+        for clause in local_task_clauses(text or ""):
+            if not (_LOCAL_WORK_TASK_RE.search(clause) or _contains_action_signal(clause, ActionClass.TERMINAL_EXECUTION)):
+                continue
+            if _NEGATED_AUTHORITY_RE.search(clause) or _DOCUMENTARY_AUTHORITY_RE.search(clause):
+                continue
+            return True
+        return False
+
+    if not has_affirmative_local_authority_clause(trusted_user_text):
+        return False
+    if not trusted_policy_text:
+        return True
+    return has_affirmative_local_authority_clause(f"{trusted_user_text}\n{trusted_policy_text}")
+
+
+def _trusted_local_work_decision(
+    name: str,
+    action_class: ActionClass,
+    args: Mapping[str, Any] | None,
+    trusted_user_text: str,
+    trusted_policy_text: str,
+    combined_untrusted: list[tuple[str | None, str]],
+) -> ActionAuthorityResult | None:
+    """Allow safe local development actions under trusted user/local policy.
+
+    This gate is deliberately narrower than exact scoped authority. It covers
+    routine local repo work while still failing closed on untrusted
+    parameterization, secrets, network, sudo, publish, and destructive commands.
+    """
+    if not _trusted_task_supports_local_work(trusted_user_text, trusted_policy_text):
+        return None
+    args = args or {}
+    cwd_raw = str(args.get("workdir") or args.get("cwd") or os.getcwd())
+    cwd = Path(cwd_raw).expanduser()
+    if not cwd.is_absolute():
+        cwd = Path.cwd() / cwd
+    try:
+        cwd = cwd.resolve(strict=False)
+    except Exception:
+        return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, action_class, reason="local authority could not resolve working directory", source="trusted_confirmation_required")
+    trusted_scope_text = "\n".join(part for part in (trusted_user_text, trusted_policy_text) if part)
+
+    if name in {"terminal", "execute_code", "process"} or action_class == ActionClass.TERMINAL_EXECUTION:
+        command = str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+        trusted_pathish_tokens = [
+            token.strip(".,;:()[]{}\"'")
+            for token in _command_words(trusted_user_text)
+            if _looks_like_concrete_local_path(token)
+        ]
+        meaningful_trusted_paths = [token for token in trusted_pathish_tokens if token not in {"test/build", "tests/build", "test/builds", "tests/builds"}]
+        if _contains_action_signal(trusted_user_text, action_class) and meaningful_trusted_paths:
+            return None
+        if _terminal_command_from_external_untrusted(command, trusted_scope_text, combined_untrusted):
+            return ActionAuthorityResult(AuthorityDecision.BLOCK, action_class, reason="local authority denied terminal command supplied by evidence-only untrusted context", source=next((src for src, _ in _external_untrusted_blocks(combined_untrusted) if src), "untrusted_context"))
+        denial = _command_denied_by_local_policy(command, cwd, root=cwd, trusted_scope_text=trusted_scope_text)
+        if denial:
+            return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, action_class, reason=denial, source="trusted_confirmation_required")
+        if _dev_terminal_parameterized_by_untrusted(command, trusted_scope_text, _external_untrusted_blocks(combined_untrusted)):
+            return ActionAuthorityResult(AuthorityDecision.BLOCK, action_class, reason="local authority denied terminal target parameterized by evidence-only untrusted context", source=next((src for src, _ in _external_untrusted_blocks(combined_untrusted) if src), "untrusted_context"))
+        return ActionAuthorityResult(AuthorityDecision.ALLOW, action_class, source="trusted_local_work")
+
+    if action_class == ActionClass.FILE_WRITE:
+        if combined_untrusted and _untrusted_parameterized_targets(name, action_class, args, trusted_scope_text, combined_untrusted):
+            return ActionAuthorityResult(AuthorityDecision.BLOCK, action_class, reason="local authority denied file write parameterized by evidence-only untrusted context", source=next((src for src, _ in combined_untrusted if src), "untrusted_context"))
+        for value in _authority_target_strings(name, action_class, args):
+            if _secretish_path(value):
+                return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, action_class, reason="local authority denied secret-like file target", source="trusted_confirmation_required")
+            if _looks_pathish(value) and not _path_under_root(value, cwd, cwd=cwd):
+                return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, action_class, reason="local authority denied file target outside current working tree", source="trusted_confirmation_required")
+        return ActionAuthorityResult(AuthorityDecision.ALLOW, action_class, source="trusted_local_work")
+
+    return None
+
+
+def _trusted_terminal_read_only_network_fetch_decision(
+    name: str,
+    action_class: ActionClass,
+    args: Mapping[str, Any] | None,
+    trusted_scope_text: str,
+    combined_untrusted: list[tuple[str | None, str]],
+) -> ActionAuthorityResult | None:
+    if not (name in {"terminal", "execute_code", "process"} or action_class == ActionClass.TERMINAL_EXECUTION):
+        return None
+    args = args or {}
+    command = str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+    if not _trusted_read_only_terminal_fetch(command, trusted_scope_text):
+        return None
+    if _terminal_command_from_external_untrusted(command, trusted_scope_text, combined_untrusted):
