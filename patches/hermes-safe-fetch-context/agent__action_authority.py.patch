+def _read_only_git_segment_scope_paths(segment: list[str]) -> list[str] | None:
+    if len(segment) < 2 or os.path.basename(segment[0]).lower() != "git":
+        return None
+    scope_paths: list[str] = []
+    index = 1
+    while index < len(segment):
+        token = segment[index]
+        if token == "--no-pager":
+            index += 1
+            continue
+        if token == "-C":
+            index += 1
+            if index >= len(segment):
+                return None
+            scope_paths.append(segment[index])
+            index += 1
+            continue
+        if token.startswith("-C") and len(token) > 2:
+            scope_paths.append(token[2:])
+            index += 1
+            continue
+        break
+    if index >= len(segment):
+        return None
+    subcommand = segment[index].lower()
+    index += 1
+    path_mode = False
+    if subcommand == "status":
+        safe_flags = _GIT_STATUS_SAFE_FLAGS
+    elif subcommand == "diff":
+        safe_flags = _GIT_DIFF_SAFE_FLAGS
+    else:
+        return None
+    while index < len(segment):
+        token = segment[index]
+        if token == "--":
+            path_mode = True
+            index += 1
+            continue
+        if path_mode:
+            scope_paths.append(token)
+            index += 1
+            continue
+        if token in safe_flags:
+            index += 1
+            continue
+        if subcommand == "diff" and token.startswith("--diff-filter="):
+            index += 1
+            continue
+        if token.startswith("-"):
+            return None
+        return None
+    return scope_paths
+
+
+def _read_only_git_inspection_scope_paths(command: str) -> list[str] | None:
+    if _unsafe_shell_expansion(command):
+        return None
+    tokens = _shell_punctuation_tokens(command)
+    if not tokens:
+        return None
+    if any(token in (_SHELL_CONTROL_TOKENS - {"&&"}) for token in tokens):
+        return None
+    segments: list[list[str]] = [[]]
+    for token in tokens:
+        if token == "&&":
+            if not segments[-1]:
+                return None
+            segments.append([])
+            continue
+        segments[-1].append(token)
+    if not segments[-1]:
+        return None
+    scope_paths: list[str] = []
+    for segment in segments:
+        segment_paths = _read_only_git_segment_scope_paths(segment)
+        if segment_paths is None:
+            return None
+        scope_paths.extend(segment_paths)
+    return scope_paths
+
+
+def _trusted_terminal_read_only_git_inspection_decision(
+    name: str,
+    action_class: ActionClass,
+    args: Mapping[str, Any] | None,
+    trusted_scope_text: str,
+    combined_untrusted: list[tuple[str | None, str]],
+) -> ActionAuthorityResult | None:
+    if not (name in {"terminal", "execute_code", "process"} or action_class == ActionClass.TERMINAL_EXECUTION):
+        return None
+    args = args or {}
+    command = str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+    scope_paths = _read_only_git_inspection_scope_paths(command)
+    if scope_paths is None:
+        return None
+    trusted_text = trusted_scope_text or ""
+    if not _trusted_scope_supports_read_only_git_inspection(trusted_text):
+        return None
+    cwd_raw = str(args.get("workdir") or args.get("cwd") or "")
+    cwd = Path(cwd_raw).expanduser() if cwd_raw else None
+    if cwd is not None and not cwd.is_absolute():
+        cwd = Path.cwd() / cwd
+    if cwd is not None:
+        try:
+            cwd = cwd.resolve(strict=False)
+        except Exception:
+            return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, action_class, reason="local authority could not resolve working directory", source="trusted_confirmation_required")
+        if _looks_pathish(cwd_raw) and not _value_in_text(str(cwd), trusted_text) and not _value_in_text(cwd_raw, trusted_text):
+            return None
+    for value in scope_paths:
+        if value in {".", "./"}:
+            continue
+        if _secretish_path(value):
+            return None
+        if _looks_pathish(value):
+            if cwd is not None and _path_under_root(value, cwd, cwd=cwd):
+                continue
+            if _value_in_text(value, trusted_text):
+                continue
+            return None
+    if _terminal_command_from_external_untrusted(command, trusted_text, combined_untrusted):
+        return ActionAuthorityResult(
+            AuthorityDecision.BLOCK,
+            action_class,
+            reason="local authority denied git inspection command supplied by evidence-only untrusted context",
+            source=next((src for src, _ in _external_untrusted_blocks(combined_untrusted) if src), "untrusted_context"),
+        )
+    if _dev_terminal_parameterized_by_untrusted(command, trusted_text, _external_untrusted_blocks(combined_untrusted)):
+        return ActionAuthorityResult(
+            AuthorityDecision.BLOCK,
+            action_class,
+            reason="local authority denied git inspection target parameterized by evidence-only untrusted context",
+            source=next((src for src, _ in _external_untrusted_blocks(combined_untrusted) if src), "untrusted_context"),
+        )
+    return ActionAuthorityResult(AuthorityDecision.ALLOW, action_class, source="trusted_read_only_verification")
+
+
+def _trusted_terminal_read_only_absence_check_decision(
+    name: str,
+    action_class: ActionClass,
+    args: Mapping[str, Any] | None,
+    trusted_scope_text: str,
+    combined_untrusted: list[tuple[str | None, str]],
+) -> ActionAuthorityResult | None:
+    if not (name in {"terminal", "execute_code", "process"} or action_class == ActionClass.TERMINAL_EXECUTION):
+        return None
+    args = args or {}
+    command = str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+    parts = _read_only_absence_check_parts(command)
+    if parts is None:
+        return None
+    path, echo_token = parts
+    path_variants = _safe_absence_path_variants(path)
+    trusted_text = trusted_scope_text or ""
+    if not any(_value_in_text(variant, trusted_text) for variant in path_variants):
+        return None
+    if not _value_in_text(echo_token, trusted_text):
+        return None
+    if _terminal_command_from_external_untrusted(command, trusted_text, combined_untrusted):
+        return ActionAuthorityResult(
+            AuthorityDecision.BLOCK,
+            action_class,
+            reason="local authority denied absence check command supplied by evidence-only untrusted context",
+            source=next((src for src, _ in _external_untrusted_blocks(combined_untrusted) if src), "untrusted_context"),
+        )
+    if _dev_terminal_parameterized_by_untrusted(command, trusted_text, _external_untrusted_blocks(combined_untrusted)):
+        return ActionAuthorityResult(
+            AuthorityDecision.BLOCK,
+            action_class,
+            reason="local authority denied absence check target parameterized by evidence-only untrusted context",
+            source=next((src for src, _ in _external_untrusted_blocks(combined_untrusted) if src), "untrusted_context"),
+        )
+    return ActionAuthorityResult(AuthorityDecision.ALLOW, action_class, source="trusted_read_only_verification")
+
+
+@dataclass(frozen=True)
+class ActionAuthorityContext:
+    tool_name: str
+    name: str
+    args: Mapping[str, Any]
+    action_class: ActionClass
+    trusted_text: str
+    trusted_policy_text: str
+    trusted_scope_text: str
+    combined_untrusted: list[tuple[str | None, str]]
+    external_untrusted: list[tuple[str | None, str]]
+    command: str
+    policy_allows_without_user_intent: bool
+
+
+ActionAuthorityPolicy = Callable[[ActionAuthorityContext], ActionAuthorityResult | None]
+
+
+def _action_command(args: Mapping[str, Any] | None) -> str:
+    args = args or {}
+    return str(args.get("command") or args.get("code") or args.get("script") or args.get("data") or "")
+
+
+def _build_action_authority_context(
+    tool_name: str,
+    args: Mapping[str, Any] | None,
+    *,
+    trusted_user_intent: str | None,
+    trusted_policy_context: str | None,
+    policy_allows_without_user_intent: bool,
+    prior_untrusted_context: str | None,
+) -> ActionAuthorityContext:
+    normalized_args = args or {}
+    name = (tool_name or "").lower()
+    action_class = classify_action(tool_name, normalized_args)
+    arg_text = _stringify(normalized_args)
+    user_text = trusted_user_intent or ""
+    prior_text = prior_untrusted_context or ""
+    combined_untrusted = _untrusted_blocks(arg_text) + _untrusted_blocks(user_text) + _untrusted_blocks(prior_text)
+    if prior_text and not _untrusted_blocks(prior_text):
+        combined_untrusted.append(("prior_untrusted_tool_result", prior_text))
+    trusted_text = _trusted_text_without_untrusted(user_text)
+    trusted_policy_text = _trusted_text_without_untrusted(trusted_policy_context or "")
+    trusted_scope_text = "\n".join(part for part in (trusted_text, trusted_policy_text) if part)
+    return ActionAuthorityContext(
+        tool_name=tool_name,
+        name=name,
+        args=normalized_args,
+        action_class=action_class,
+        trusted_text=trusted_text,
+        trusted_policy_text=trusted_policy_text,
+        trusted_scope_text=trusted_scope_text,
+        combined_untrusted=combined_untrusted,
+        external_untrusted=_external_untrusted_blocks(combined_untrusted),
+        command=_action_command(normalized_args),
+        policy_allows_without_user_intent=policy_allows_without_user_intent,
+    )
+
+
+def _is_terminal_action(ctx: ActionAuthorityContext) -> bool:
+    return ctx.name in {"terminal", "execute_code", "process"} or ctx.action_class == ActionClass.TERMINAL_EXECUTION
+
+
+def _policy_execution_decode_of_untrusted_evidence(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if not _is_terminal_action(ctx):
+        return None
+    decode_from_untrusted, decode_source = _execution_decode_of_untrusted_evidence(
+        ctx.command,
+        ctx.trusted_scope_text,
+        ctx.combined_untrusted,
+    )
+    if not decode_from_untrusted:
+        return None
+    return ActionAuthorityResult(
+        AuthorityDecision.BLOCK,
+        ctx.action_class,
+        reason="decode untrusted evidence through non-execution evidence path; execution-capable decode is not authorized",
+        source=decode_source or "untrusted_context",
+    )
+
+
+def _policy_trusted_terminal_absence_check(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    return _trusted_terminal_read_only_absence_check_decision(
+        ctx.name,
+        ctx.action_class,
+        ctx.args,
+        ctx.trusted_scope_text,
+        ctx.combined_untrusted,
+    )
+
+
+def _policy_trusted_terminal_git_inspection(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    return _trusted_terminal_read_only_git_inspection_decision(
+        ctx.name,
+        ctx.action_class,
+        ctx.args,
+        ctx.trusted_scope_text,
+        ctx.combined_untrusted,
+    )
+
+
+def _policy_development_repo_override(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    return _development_repo_override_decision(
+        ctx.name,
+        ctx.action_class,
+        ctx.args,
+        ctx.trusted_scope_text,
+        ctx.combined_untrusted,
+    )
+
+
+def _policy_read_only_network_fetch(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if ctx.action_class != ActionClass.READ_ONLY_NETWORK_FETCH:
+        return None
+    if ctx.name in {"browser_scroll", "browser_back"} and not _authority_arg_strings_for_fields(ctx.args, _NETWORK_TARGET_FIELDS):
+        return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class)
+    risk = _network_egress_risk(ctx.args, ctx.trusted_scope_text, ctx.combined_untrusted)
+    if risk:
+        decision, reason, source = risk
+        return ActionAuthorityResult(decision, ctx.action_class, reason=reason, source=source)
+    return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class)
+
+
+def _policy_read_only_local_inspection(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if ctx.action_class != ActionClass.READ_ONLY_LOCAL_INSPECTION:
+        return None
+    if _is_inert_evidence_support_local_read(ctx.name, ctx.args):
+        return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class, source="evidence_support")
+    risk = _local_read_risk(ctx.args, ctx.trusted_scope_text, ctx.combined_untrusted)
+    if risk:
+        decision, reason, source = risk
+        return ActionAuthorityResult(decision, ctx.action_class, reason=reason, source=source)
+    return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class)
+
+
+def _policy_agent_loop_internal(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if ctx.action_class != ActionClass.AGENT_LOOP_INTERNAL:
+        return None
+    if ctx.name == "delegate_task":
+        delegated_from_untrusted, source = _delegation_parameterized_by_untrusted(
+            ctx.args,
+            ctx.trusted_scope_text,
+            ctx.combined_untrusted,
+        )
+        if delegated_from_untrusted and _delegation_may_have_side_effect_tools(ctx.args):
+            return ActionAuthorityResult(
+                AuthorityDecision.BLOCK,
+                ctx.action_class,
+                reason="delegation goal, context, role, transport, or tool scope was supplied by evidence-only untrusted context",
+                source=source or "untrusted_context",
+            )
+    if ctx.policy_allows_without_user_intent or ctx.name in EXPLICIT_TOOL_EXEMPTIONS:
+        return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class, source="agent_loop_internal")
+    return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, ctx.action_class, reason="agent-loop tool requires explicit mediation", source="trusted_confirmation_required")
+
+
+def _policy_unknown_side_effect(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if ctx.action_class != ActionClass.UNKNOWN_SIDE_EFFECT:
+        return None
+    if ctx.combined_untrusted:
+        return ActionAuthorityResult(AuthorityDecision.BLOCK, ctx.action_class, reason="unknown side-effecting action cannot be authorized by untrusted context", source=next((src for src, _ in ctx.combined_untrusted if src), "untrusted_context"))
+    if not _contains_action_signal(f"{ctx.name} {_stringify(ctx.args)}", ctx.action_class):
+        return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class, source="session_scoped_dynamic_tool")
+    return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, ctx.action_class, reason="unknown tool side-effect behavior requires confirmation unless explicitly classified", source="trusted_confirmation_required")
+
+
+def _trusted_scoped_intent_decision(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    denial = _terminal_command_denial_for_exact_scope(ctx.name, ctx.action_class, ctx.args, ctx.trusted_scope_text)
+    if denial:
+        if _terminal_denial_should_defer_to_terminal_guard(denial, ctx.args, ctx.trusted_scope_text):
+            return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class, source="trusted_scoped_intent")
+        return ActionAuthorityResult(AuthorityDecision.REQUIRE_CONFIRMATION, ctx.action_class, reason=denial, source="trusted_confirmation_required")
+    return ActionAuthorityResult(AuthorityDecision.ALLOW, ctx.action_class, source="trusted_scoped_intent")
+
+
+def _policy_early_trusted_scoped_intent(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if ctx.action_class == ActionClass.OUTBOUND_MESSAGE or ctx.name.startswith("browser_"):
+        return None
+    if not _trusted_scopes_action_targets(ctx.name, ctx.action_class, ctx.args, ctx.trusted_scope_text, ctx.combined_untrusted):
+        return None
+    return _trusted_scoped_intent_decision(ctx)
+
+
+def _policy_untrusted_side_effect_parameterization(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if not ctx.combined_untrusted:
+        return None
+    generic_untrusted = ctx.combined_untrusted
+    if _trusted_task_supports_local_work(ctx.trusted_text, ctx.trusted_policy_text):
+        generic_untrusted = ctx.external_untrusted
+    untrusted_has_action = any(_contains_action_signal(body, ctx.action_class) for _, body in generic_untrusted)
+    trusted_has_action = _contains_action_signal(ctx.trusted_scope_text, ctx.action_class)
+    args_contain_untrusted = _arg_untrusted_blocks_in_authority_targets(ctx.name, ctx.action_class, ctx.args)
+    high_risk_untrusted_action = ctx.action_class in {ActionClass.SECRET_READ, ActionClass.SECRET_TRANSMISSION}
+    args_parameterized_by_untrusted = _untrusted_parameterized_targets(ctx.name, ctx.action_class, ctx.args, ctx.trusted_scope_text, generic_untrusted)
+    terminal_parameterized_by_untrusted = False
+    if _is_terminal_action(ctx):
+        terminal_parameterized_by_untrusted = _dev_terminal_parameterized_by_untrusted(ctx.command, ctx.trusted_scope_text, generic_untrusted)
+    if args_contain_untrusted or high_risk_untrusted_action or args_parameterized_by_untrusted or terminal_parameterized_by_untrusted or (untrusted_has_action and not trusted_has_action):
+        source = next((src for src, _ in (generic_untrusted or ctx.combined_untrusted) if src), "untrusted_context")
+        return ActionAuthorityResult(
+            AuthorityDecision.BLOCK,
+            ctx.action_class,
+            reason="side-effecting action was requested or parameterized by evidence-only untrusted context",
+            source=source,
+        )
+    return None
+
+
+def _policy_outbound_message_risk(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if ctx.action_class != ActionClass.OUTBOUND_MESSAGE:
+        return None
+    risk = _outbound_payload_risk(ctx.args, ctx.trusted_scope_text, ctx.combined_untrusted)
+    if not risk:
+        return None
+    decision, reason, source = risk
+    return ActionAuthorityResult(decision, ctx.action_class, reason=reason, source=source)
+
+
+def _policy_browser_explicit_scope(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if not (ctx.name.startswith("browser_") and _browser_action_requires_explicit_scope(ctx.name, ctx.args, ctx.trusted_scope_text)):
+        return None
+    return ActionAuthorityResult(
+        AuthorityDecision.REQUIRE_CONFIRMATION,
+        ctx.action_class,
+        reason="high-risk browser action requires exact trusted origin/action/target scope; page labels, refs, selectors, accessible names, and DOM text are evidence-only",
+        source="trusted_confirmation_required",
+    )
+
+
+def _policy_trusted_terminal_read_only_network_fetch(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    return _trusted_terminal_read_only_network_fetch_decision(
+        ctx.name,
+        ctx.action_class,
+        ctx.args,
+        ctx.trusted_scope_text,
+        ctx.combined_untrusted,
+    )
+
+
+def _policy_trusted_scoped_intent(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    if not _trusted_scopes_action_targets(ctx.name, ctx.action_class, ctx.args, ctx.trusted_scope_text, ctx.combined_untrusted):
+        return None
+    return _trusted_scoped_intent_decision(ctx)
+
+
+def _policy_trusted_local_work(ctx: ActionAuthorityContext) -> ActionAuthorityResult | None:
+    return _trusted_local_work_decision(
+        ctx.name,
+        ctx.action_class,
+        ctx.args,
+        ctx.trusted_text,
+        ctx.trusted_policy_text,
+        ctx.combined_untrusted,
+    )
+
+
+_ACTION_AUTHORITY_POLICIES: tuple[ActionAuthorityPolicy, ...] = (
+    _policy_execution_decode_of_untrusted_evidence,
+    _policy_trusted_terminal_absence_check,
+    _policy_trusted_terminal_git_inspection,
+    _policy_development_repo_override,
+    _policy_read_only_network_fetch,
+    _policy_read_only_local_inspection,
+    _policy_agent_loop_internal,
+    _policy_unknown_side_effect,
+    _policy_early_trusted_scoped_intent,
+    _policy_untrusted_side_effect_parameterization,
+    _policy_outbound_message_risk,
+    _policy_browser_explicit_scope,
+    _policy_trusted_terminal_read_only_network_fetch,
+    _policy_trusted_scoped_intent,
+    _policy_trusted_local_work,
+)
