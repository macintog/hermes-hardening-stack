+def _resolve_existing_absolute_dir(value: str) -> Path | None:
+    try:
+        path = Path(value).expanduser().resolve(strict=False)
+    except Exception:
+        return None
+    if not path.is_absolute() or not path.exists() or not path.is_dir() or path == Path(path.anchor):
+        return None
+    return path
+
+
+_LOCAL_SCOPE_PATH_TOKEN_RE = re.compile(r"(?:~|/)[^\s,;:()\[\]{}\"'`<>]+")
+
+
+def _trusted_local_scope_roots(trusted_text: str) -> list[Path]:
+    roots: list[Path] = []
+    for match in _LOCAL_SCOPE_PATH_TOKEN_RE.finditer(trusted_text or ""):
+        token = match.group(0).rstrip(".,")
+        root = _resolve_existing_absolute_dir(token)
+        if root is not None and root not in roots:
+            roots.append(root)
+    return roots
+
+
+def _trusted_scope_covers_local_read(value: str, trusted_text: str) -> bool:
+    if not value or _secretish_path(value):
+        return False
+    if not _trusted_task_supports_local_work(trusted_text, ""):
+        return False
+    try:
+        candidate = Path(value).expanduser()
+        if not candidate.is_absolute():
+            return False
+        candidate = candidate.resolve(strict=False)
+    except Exception:
+        return False
+    for root in _trusted_local_scope_roots(trusted_text):
+        try:
+            candidate.relative_to(root)
+            return True
+        except ValueError:
+            continue
+    return False
+
+
+def _env_flag(name: str) -> bool:
+    return os.environ.get(name, "").strip() == "1"
+
+
+def _resolve_dev_tmp_prefix(value: str) -> str | None:
+    try:
+        raw = value.strip()
+        if not raw:
+            return None
+        prefix = Path(os.path.abspath(os.path.expanduser(raw)))
+        if not prefix.is_absolute() or str(prefix) == prefix.anchor:
+            return None
+        if prefix.name in {"", ".", ".."} or not prefix.name.startswith("hermes-dev-"):
+            return None
+        parent = prefix.parent.resolve(strict=True)
+        temp_roots = {Path(tempfile.gettempdir()).resolve(strict=True)}
+        for candidate in ("/tmp", "/var/tmp", "/private/tmp"):
+            path = Path(candidate)
+            if path.exists():
+                temp_roots.add(path.resolve(strict=True))
+        if not any(parent == temp_root or parent.is_relative_to(temp_root) for temp_root in temp_roots):
+            return None
+        return str(prefix)
+    except Exception:
+        return None
+
+
+@dataclass(frozen=True)
+class DevelopmentAuthority:
+    root: Path
+    tmp_prefixes: tuple[str, ...]
+    allow_commit: bool = False
+    allow_network: bool = False
+    allow_sudo: bool = False
+
+    @classmethod
+    def from_env(cls) -> "DevelopmentAuthority | None":
+        if os.environ.get(_DEV_AUTHORITY_ENABLE_ENV, "").strip() != "1":
+            return None
+        raw_root = os.environ.get(_DEV_AUTHORITY_ROOT_ENV, "").strip()
+        if not raw_root:
+            return None
+        root = _resolve_existing_absolute_dir(raw_root)
+        if root is None:
+            return None
+        marker_scoped = (
+            (root / "patches" / "hermes-safe-fetch-context" / "manifest.yaml").is_file()
+            and (root / "AGENTS.md").is_file()
+        )
+        safe_root_scoped = False
+        raw_safe_root = os.environ.get(_DEV_AUTHORITY_SAFE_ROOT_ENV, "").strip()
+        if raw_safe_root:
+            safe_root = _resolve_existing_absolute_dir(raw_safe_root)
+            if safe_root is None:
+                return None
+            try:
+                root.relative_to(safe_root)
+                safe_root_scoped = True
+            except ValueError:
+                safe_root_scoped = False
+        # This lease is for local Hermes hardening work only. Refuse broad or
+        # generic roots unless the process environment also pins them under an
+        # explicit existing safe root.
+        if not (marker_scoped or safe_root_scoped):
+            return None
+        raw_tmp = os.environ.get(_DEV_AUTHORITY_TMP_PREFIX_ENV, "").strip()
+        custom_tmp_prefix = _resolve_dev_tmp_prefix(raw_tmp) if raw_tmp else _DEFAULT_DEV_TMP_PREFIX
+        if custom_tmp_prefix is None:
+            return None
+        tmp_prefixes = (custom_tmp_prefix, _VERIFIER_TMP_PREFIX)
+        return cls(
+            root=root,
+            tmp_prefixes=tmp_prefixes,
+            allow_commit=_env_flag(_DEV_AUTHORITY_ALLOW_COMMIT_ENV),
+            allow_network=_env_flag(_DEV_AUTHORITY_ALLOW_NETWORK_ENV),
+            allow_sudo=_env_flag(_DEV_AUTHORITY_ALLOW_SUDO_ENV),
+        )
+
+    @property
+    def scope_root(self) -> str:
+        return str(self.root)
+
+    def result(self, decision: AuthorityDecision, action_class: ActionClass, reason: str = "") -> ActionAuthorityResult:
+        source = _DEV_AUTHORITY_SOURCE if decision == AuthorityDecision.ALLOW else _DEV_AUTHORITY_DENIED_SOURCE
+        return ActionAuthorityResult(decision, action_class, reason=reason, source=source, scope_root=self.scope_root)
+
