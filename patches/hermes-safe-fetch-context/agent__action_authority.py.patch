+
+_PAYLOAD_CONTENT_FIELDS: dict[ActionClass, tuple[str, ...]] = {
+    ActionClass.OUTBOUND_MESSAGE: ("body", "text", "message", "content", "payload", "data"),
+    ActionClass.FILE_WRITE: ("content", "text", "body", "payload", "data"),
+}
+
+_PRIVATE_CONTEXT_SOURCES = {
+    "memory_context",
+    "session_search",
+    "local_file",
+    "read_only_local_inspection",
+}
+
+_LOCAL_INSPECTION_EVIDENCE_SOURCES = {
+    "search_files",
+    "read_only_local_inspection",
+}
