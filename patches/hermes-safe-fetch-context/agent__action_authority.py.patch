+"""Deterministic authority gate for model-proposed actions.
+
+This module is intentionally local and dependency-light.  It does not try to
+infer model intent.  It answers one narrow security question: is a proposed
+side-effecting action authorized by trusted user/system/developer policy, or is
+it being authorized only by evidence-only untrusted context?
+"""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import hashlib
+import json
+import os
+import re
+import shlex
+import tempfile
+from dataclasses import dataclass
+from enum import StrEnum
+from pathlib import Path
+from typing import Any, Callable, Mapping
+from urllib.parse import parse_qsl, unquote, urlsplit
+
+from agent.action_authority_catalog import (
+    AGENT_LOOP_INTERNAL_TOOLS,
+    EXPLICIT_TOOL_EXEMPTIONS,
+    HIGH_RISK_APPROVAL_CLASSES as _HIGH_RISK_APPROVAL_CLASSES,
+    TOOL_ACTION_CLASSES as _TOOL_ACTION_CLASSES,
+    ActionClass,
+    action_authority_coverage_gaps,
+    action_class_for_tool,
+    classified_tool_names,
+)
+
+ACTION_DECISION_SCHEMA = "hermes.action_decision.v1"
+
+
+class AuthorityDecision(StrEnum):
+    ALLOW = "allow"
+    REQUIRE_CONFIRMATION = "require_confirmation"
+    BLOCK = "block"
+
+
+_EVIDENCE_SUPPORT_SKILL_VIEWS = {
+    "untrusted-content-analysis",
+}
+
+_DELEGATION_READ_ONLY_TOOLSETS = {
+    "web",
+    "search",
+    "research",
+    "read",
+    "readonly",
+    "read_only",
+    "local_read",
+    "session_search",
+}
+_DELEGATION_SIDE_EFFECT_TOOLSETS = {
+    "terminal",
+    "file",
+    "files",
+    "filesystem",
+    "browser",
+    "code",
+    "code_execution",
+    "memory",
+    "cron",
+    "message",
+    "messaging",
