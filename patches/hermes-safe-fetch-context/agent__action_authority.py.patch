+
+def evaluate_action_authority(
+    tool_name: str,
+    args: Mapping[str, Any] | None = None,
+    *,
+    trusted_user_intent: str | None = None,
+    trusted_policy_context: str | None = None,
+    policy_allows_without_user_intent: bool = False,
+    prior_untrusted_context: str | None = None,
+) -> ActionAuthorityResult:
+    ctx = _build_action_authority_context(
+        tool_name,
+        args,
+        trusted_user_intent=trusted_user_intent,
+        trusted_policy_context=trusted_policy_context,
+        policy_allows_without_user_intent=policy_allows_without_user_intent,
+        prior_untrusted_context=prior_untrusted_context,
+    )
+    for policy in _ACTION_AUTHORITY_POLICIES:
+        decision = policy(ctx)
+        if decision is not None:
+            return decision
+
+    return ActionAuthorityResult(
+        AuthorityDecision.REQUIRE_CONFIRMATION,
+        ctx.action_class,
+        reason="side-effecting action lacks explicit trusted scoped authority for action class and target/scope",
+        source="trusted_confirmation_required",
+    )
