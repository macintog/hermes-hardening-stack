+
+_READ_ONLY_GIT_SCOPE_RE = re.compile(
+    r"(?i)\bgit\b.*\b(status|diff|read[-\s]?only|inspect(?:ion)?|review|check|changes?|uncommitted)\b|"
+    r"\b(status|diff|read[-\s]?only|inspect(?:ion)?|review|check|changes?|uncommitted)\b.*\bgit\b"
+)
+_GIT_STATUS_SAFE_FLAGS = {
+    "-s",
+    "-b",
+    "-sb",
+    "--short",
+    "--branch",
+    "--porcelain",
+    "--porcelain=v1",
+    "--porcelain=v2",
+    "--untracked-files=no",
+    "--untracked-files=normal",
+    "--untracked-files=all",
+    "-uno",
+}
+_GIT_DIFF_SAFE_FLAGS = {
+    "--cached",
+    "--staged",
+    "--stat",
+    "--shortstat",
+    "--summary",
+    "--numstat",
+    "--name-only",
+    "--name-status",
+    "--check",
+    "--no-ext-diff",
+    "--color",
+    "--no-color",
+    "-p",
+}
+
+
+def _trusted_scope_supports_read_only_git_inspection(trusted_scope_text: str) -> bool:
+    for clause in [
+        part.strip()
+        for part in _AUTHORITY_SCOPE_BOUNDARY_RE.split(trusted_scope_text or "")
+        if part.strip()
+    ]:
+        if not _READ_ONLY_GIT_SCOPE_RE.search(clause):
+            continue
+        if _clause_negates_or_documents_action(clause, ActionClass.TERMINAL_EXECUTION):
+            continue
+        return True
+    return False
+
