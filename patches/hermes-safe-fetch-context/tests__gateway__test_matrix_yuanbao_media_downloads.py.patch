+@pytest.mark.asyncio
+async def test_yuanbao_download_url_blocks_private_redirect():
+    async def safe_download_with_mock_transport(url, **kwargs):
+        def handler(request):
+            if str(request.url) == "https://cdn.example.test/image.png":
+                return httpx.Response(302, headers={"Location": "http://127.0.0.1/private.png"})
+            return httpx.Response(200, headers={"Content-Type": "image/png"}, content=b"\x89PNG\r\n\x1a\n")
+
+        return await real_safe_download_bytes(
+            url,
+            transport=httpx.MockTransport(handler),
+            allow_unverified_transport=True,
+            **kwargs,
+        )
+
+    with patch(
+        "gateway.platforms.yuanbao_media.safe_download_bytes",
+        side_effect=safe_download_with_mock_transport,
+    ), patch("tools.url_safety.is_safe_url", side_effect=lambda url: "127.0.0.1" not in str(url)), patch(
+        "tools.safe_http.is_safe_url",
+        side_effect=lambda url: "127.0.0.1" not in str(url),
+    ):
+        with pytest.raises(SafeHTTPError, match="Blocked"):
+            await yuanbao_download_url(
+                "https://cdn.example.test/image.png",
+                max_size_mb=5,
+                allowed_content_types=YUANBAO_IMAGE_CONTENT_TYPES,
+            )
