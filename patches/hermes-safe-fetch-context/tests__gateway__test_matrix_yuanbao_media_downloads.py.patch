+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import httpx
+import pytest
+
+from gateway.config import PlatformConfig
+from gateway.platforms.base import SendResult
+from plugins.platforms.matrix.adapter import MatrixAdapter
+from gateway.platforms.yuanbao import ImageUrlHandler, MediaResolveMiddleware
+from gateway.platforms.yuanbao_media import (
+    YUANBAO_IMAGE_CONTENT_TYPES,
+    download_url as yuanbao_download_url,
+)
+from tools.safe_http import SafeHTTPError
+from tools.safe_http import safe_download_bytes as real_safe_download_bytes
+
+
+class _SafeResult:
+    def __init__(self, content=b"\x89PNG\r\n\x1a\n image", content_type="image/png"):
+        self.content = content
+        self.content_type = content_type
+
+
+@pytest.fixture
+def matrix_adapter():
+    adapter = MatrixAdapter(
+        PlatformConfig(
+            enabled=True,
+            token="matrix-token",
+            extra={"homeserver": "https://matrix.example.test"},
+        )
+    )
+    adapter._client = AsyncMock()
+    adapter._client.upload_media = AsyncMock(return_value="mxc://example.test/media")
+    adapter._client.send_message_event = AsyncMock(return_value="$event")
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_matrix_send_image_uses_safe_download_with_image_policy(matrix_adapter):
+    calls = []
+
+    async def fake_download(url, **kwargs):
+        calls.append((url, kwargs))
+        return _SafeResult()
+
+    with patch("plugins.platforms.matrix.adapter.safe_download_bytes", side_effect=fake_download):
+        result = await matrix_adapter.send_image(
+            "!room:example.test",
+            "https://cdn.example.test/image.png?token=secret",
+            "caption",
+        )
+
+    assert result == SendResult(success=True, message_id="$event")
+    assert calls[0][0] == "https://cdn.example.test/image.png?token=secret"
+    kwargs = calls[0][1]
+    assert kwargs["source_type"] == "gateway:matrix-outbound-image"
+    assert kwargs["max_bytes"] == 100 * 1024 * 1024
+    assert kwargs["policy"]["redirect_credentials"] == "no-credentials"
+    assert "image/png" in kwargs["allowed_content_types"]
+    matrix_adapter._client.upload_media.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_matrix_send_image_blocks_private_redirect_without_url_fallback(matrix_adapter):
+    async def safe_download_with_mock_transport(url, **kwargs):
+        def handler(request):
+            if str(request.url) == "https://cdn.example.test/image.png?token=secret":
+                return httpx.Response(
+                    302,
+                    headers={"Location": "http://169.254.169.254/latest/meta-data"},
+                )
+            return httpx.Response(200, headers={"Content-Type": "image/png"}, content=b"\x89PNG\r\n\x1a\n")
+
+        return await real_safe_download_bytes(
+            url,
+            transport=httpx.MockTransport(handler),
+            allow_unverified_transport=True,
+            **kwargs,
+        )
+
+    with patch(
+        "plugins.platforms.matrix.adapter.safe_download_bytes",
+        side_effect=safe_download_with_mock_transport,
+    ), patch.object(
+        MatrixAdapter,
+        "send",
+        AsyncMock(return_value=SendResult(success=True, message_id="$fallback")),
+    ) as fallback_send:
+        result = await matrix_adapter.send_image(
+            "!room:example.test",
+            "https://cdn.example.test/image.png?token=secret",
+            "caption",
+        )
+
+    assert not result.success
+    assert "Blocked unsafe URL target" in (result.error or "")
+    fallback_send.assert_not_awaited()
+    matrix_adapter._client.upload_media.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_matrix_inbound_media_uses_provider_download_not_safe_http(matrix_adapter):
+    matrix_adapter._user_id = "@bot:example.test"
+    matrix_adapter._startup_ts = 0.0
+    matrix_adapter._dm_rooms = {}
+    matrix_adapter._client.download_media = AsyncMock(return_value=b"\x89PNG\r\n\x1a\n image")
+    matrix_adapter._client.state_store = SimpleNamespace(
+        get_member=AsyncMock(return_value=SimpleNamespace(displayname="Alice")),
+        get_members=AsyncMock(return_value=[object()]),
+    )
+    captured = []
+
+    async def capture(event):
+        captured.append(event)
+
+    matrix_adapter.handle_message = capture
+    event = SimpleNamespace(
+        event_id="$image",
+        sender="@alice:example.test",
+        room_id="!room:example.test",
+        timestamp=1_700_000_000_000,
+        content={
+            "msgtype": "m.image",
+            "body": "image.png",
+            "url": "mxc://example.test/media",
+            "info": {"mimetype": "image/png"},
+        },
+    )
+
+    with patch("plugins.platforms.matrix.adapter.safe_download_bytes", new_callable=AsyncMock) as mock_download, patch.object(
+        matrix_adapter,
+        "_resolve_message_context",
+        AsyncMock(return_value=("image.png", True, "dm", None, "Alice", "matrix:!room")),
+    ):
+        await matrix_adapter._handle_media_message(
+            event.room_id,
+            event.sender,
+            event.event_id,
+            event.timestamp / 1000.0,
+            event.content,
+            {},
+            "m.image",
+        )
+
+    mock_download.assert_not_called()
+    matrix_adapter._client.download_media.assert_awaited_once()
+    assert captured and captured[0].media_urls
+    assert not captured[0].media_urls[0].startswith("http")
+
