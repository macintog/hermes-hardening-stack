+@pytest.mark.asyncio
+async def test_yuanbao_image_url_handler_passes_image_content_policy():
+    adapter = SimpleNamespace(MEDIA_MAX_SIZE_MB=50, name="yuanbao")
+    calls = []
+
+    async def fake_download(url, **kwargs):
+        calls.append((url, kwargs))
+        return b"\x89PNG\r\n\x1a\n image", "image/png"
+
+    with patch("gateway.platforms.yuanbao.media_download_url", side_effect=fake_download):
+        file_bytes, filename, content_type = await ImageUrlHandler().acquire_file(
+            adapter,
+            image_url="https://cdn.example.test/picture.png?sig=secret",
+        )
+
+    assert file_bytes.startswith(b"\x89PNG")
+    assert filename == "picture.png"
+    assert content_type == "image/png"
+    kwargs = calls[0][1]
+    assert kwargs["source_type"] == "gateway:yuanbao-outbound-image"
+    assert kwargs["allowed_content_types"] == YUANBAO_IMAGE_CONTENT_TYPES
+
