+@pytest.mark.asyncio
+async def test_yuanbao_download_url_blocks_oversized_response():
+    async def safe_download_with_mock_transport(url, **kwargs):
+        def handler(request):
+            return httpx.Response(
+                200,
+                headers={"Content-Type": "image/png", "Content-Length": str(1024 * 1024 + 1)},
+                content=b"",
+            )
+
+        return await real_safe_download_bytes(
+            url,
+            transport=httpx.MockTransport(handler),
+            allow_unverified_transport=True,
+            **kwargs,
+        )
+
+    with patch(
+        "gateway.platforms.yuanbao_media.safe_download_bytes",
+        side_effect=safe_download_with_mock_transport,
+    ), patch("tools.url_safety.is_safe_url", return_value=True), patch("tools.safe_http.is_safe_url", return_value=True):
+        with pytest.raises(SafeHTTPError, match="Response too large"):
+            await yuanbao_download_url(
+                "https://cdn.example.test/image.png",
+                max_size_mb=1,
+                allowed_content_types=YUANBAO_IMAGE_CONTENT_TYPES,
+            )
+
