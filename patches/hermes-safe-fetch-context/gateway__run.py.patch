+def _run_conversation_supports_active_user_intent(agent: Any) -> bool:
+    """Return whether an agent run_conversation accepts active_user_intent."""
+    try:
+        signature = inspect.signature(agent.run_conversation)
+    except (TypeError, ValueError, AttributeError):
+        return True
+    return (
+        "active_user_intent" in signature.parameters
+        or any(param.kind == inspect.Parameter.VAR_KEYWORD for param in signature.parameters.values())
+    )
+
+
+def _gateway_active_intent_secret() -> str:
+    return (
+        os.getenv("HERMES_GATEWAY_ACTIVE_INTENT_SECRET", "").strip()
+        or os.getenv("GATEWAY_ACTIVE_INTENT_SECRET", "").strip()
+    )
+
+
+def _gateway_active_intent_signature(raw_body: bytes, *, timestamp: str, nonce: str, secret: str) -> str:
+    payload = b"\n".join([
+        b"hermes-gateway-active-intent-v2",
+        timestamp.encode("utf-8"),
+        nonce.encode("utf-8"),
+        raw_body,
+    ])
+    return hmac.new(secret.encode("utf-8"), payload, hashlib.sha256).hexdigest()
+
+
+def _gateway_active_intent_signature_headers(raw_body: bytes) -> dict[str, str]:
+    secret = _gateway_active_intent_secret()
+    if not secret:
+        return {}
+    timestamp = str(int(time.time()))
+    nonce = uuid.uuid4().hex
+    return {
+        "X-Hermes-Gateway-Active-Intent": "hermes-gateway-remote-proxy-v2",
+        "X-Hermes-Gateway-Active-Intent-Timestamp": timestamp,
+        "X-Hermes-Gateway-Active-Intent-Nonce": nonce,
+        "X-Hermes-Gateway-Active-Intent-Signature": _gateway_active_intent_signature(
+            raw_body,
+            timestamp=timestamp,
+            nonce=nonce,
+            secret=secret,
+        ),
+    }
