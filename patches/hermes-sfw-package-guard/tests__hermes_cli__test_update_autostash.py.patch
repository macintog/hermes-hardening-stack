+def test_install_heartbeat_routes_package_manager_through_sfw(monkeypatch):
+    """Dependency install retries should share the same SFW wrapping path."""
+    seen = {}
+
+    def fake_wrap(cmd, *, env=None, force=False):
+        seen["wrap"] = (cmd, env, force)
+        return ["/shim/sfw-package-shim", "uv", "pip", "install", "-e", "."], {"PATH": "wrapped"}
+
+    def fake_run(cmd, **kwargs):
+        seen["run"] = (cmd, kwargs)
+        return SimpleNamespace(returncode=0)
+
+    monkeypatch.setattr(hermes_main, "_wrap_package_manager_argv_for_sfw", fake_wrap)
+    monkeypatch.setattr(hermes_main.subprocess, "run", fake_run)
+
+    hermes_main._run_install_with_heartbeat(
+        ["/usr/bin/uv", "pip", "install", "-e", "."],
+        env={"PATH": "base"},
+    )
+
+    assert seen["wrap"] == (
+        ["/usr/bin/uv", "pip", "install", "-e", "."],
+        {"PATH": "base"},
+        False,
+    )
+    assert seen["run"][0] == ["/shim/sfw-package-shim", "uv", "pip", "install", "-e", "."]
+    assert seen["run"][1]["env"] == {"PATH": "wrapped"}
+
