+    def test_self_update_uses_socket_firewall_wrapper(self, tmp_path):
+        _make_executable(tmp_path / "bin" / "uv")
+        wrapped_env = {"PATH": "shim-path"}
+        with patch("hermes_cli.managed_uv.get_hermes_home", return_value=tmp_path), \
+             patch(
+                 "hermes_cli.managed_uv.wrap_package_manager_command_for_sfw",
